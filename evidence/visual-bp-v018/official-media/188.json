{"sfxsyt_8000":"1","ename":"188","yxpyzs_1738":"dayu","cname":"\u5927\u79b9","title":"\u9f0e\u9547\u5c71\u6cb3","pay_type":"11","new_type":"1","hero_type":"6","hero_type2":"3","hero_type3":"","hero_type4":"","survive_value":"7","attack_value":"6","skill_value":"6","difficulty_value":"5","skin_name":"\u9f0e\u9547\u5c71\u6cb3&0","story":"<p>\u65e9\u5728\u5efa\u6728\u5929\u68af\u5c1a\u5b58\u4e4b\u9645\uff0c\u5927\u79b9\u4fbf\u81ea\u5012\u60ac\u5929\u800c\u6765\uff0c\u4e0e\u5f52\u5c71\u4e00\u65cf\u7f14\u7ed3\u4e86\u6df1\u539a\u7684\u60c5\u8c0a\u3002\u7136\u800c\u201c\u5947\u8ff9\u4e4b\u6218\u201d\u9aa4\u7136\u7206\u53d1\uff0c\u5929\u68af\u65ad\u88c2\uff0c\u7d0a\u6d41\u503e\u6cfb\u800c\u4e0b\uff0c\u6467\u6bc1\u4e86\u6240\u6709\u4eba\u7684\u5bb6\u56ed\u3002<\/p>\n\n<p>\u5927\u79b9\u4e8e\u5371\u96be\u4e2d\u5e26\u9886\u5f52\u5c71\u4e00\u65cf\u5171\u6297\u707e\u52ab\uff0c\u65e2\u7136\u7d0a\u6d41\u6765\u81ea\u5929\u7a7a\uff0c\u90a3\u4ed6\u4eec\u4fbf\u767b\u5929\u800c\u4e0a\uff0c\u53bb\u6218\u80dc\u82e6\u96be\u7684\u6e90\u5934\uff01\u4ed6\u4ee5\u8eab\u4e3a\u5824\uff0c\u6df1\u5165\u7d0a\u6d41\u6700\u524d\u7ebf\u3002\u5728\u90a3\u4e9b\u8270\u96be\u7684\u5c81\u6708\u91cc\uff0c\u5927\u79b9\u7528\u723d\u6717\u7684\u7b11\u58f0\u9f13\u821e\u65cf\u4eba\u3001\u9a71\u6563\u6050\u60e7\u3002\u4ed6\u4eec\u786c\u751f\u751f\u5728\u6df7\u4e71\u7684\u7d0a\u6d41\u4e4b\u6d77\u4e2d\uff0c\u51ff\u51fa\u4e86\u4e00\u6761\u767b\u5929\u4e4b\u8def\uff01<\/p>\n\n \n\n<p>\u5982\u4eca\uff0c\u5728\u5341\u51e0\u4ee3\u4eba\u7684\u62fc\u640f\u4e0b\uff0c\u5927\u79b9\u548c\u5f52\u5c71\u4e00\u65cf\u7ec8\u4e8e\u94f8\u6210\u4e86\u80fd\u51c0\u5316\u7d0a\u6d41\u7684\u4e5d\u9f0e\u3002\u4ed6\u4eec\u575a\u4fe1\uff0c\u8fd9\u573a\u7ef5\u5ef6\u4e86\u4e94\u767e\u5e74\u7684\u5929\u707e\uff0c\u7ec8\u5c06\u843d\u5e55\u2026\u2026<\/p>\n\n<p><b><\/b><\/p><p><b><font color=\"#007ac0\">\u65b0\u5c81\u70df\u706b<\/font><\/b><\/p>\n\n<p>\u201c\u4f2f\u76ca\uff0c\u544a\u8bc9\u4f60\u4e00\u4e2a\u597d\u6d88\u606f\u3002\u201d<\/p>\n\n<p>\u201c\u4e24\u767e\u5e74\u524d\uff0c\u4f60\u5728\u7d0a\u6d41\u6d77\u95ef\u4e0b\u7684\u6210\u7ee9\uff0c\u4eca\u5e74\u7ec8\u4e8e\u88ab\u6253\u7834\u4e86\u3002\u201d<\/p>\n\n<p>\u5927\u79b9\u5750\u5728\u7834\u6653\u5723\u5c71\u7684\u5c71\u5c97\u4e0a\uff0c\u8eab\u8fb9\u6563\u7740\u8bb8\u591a\u4f73\u917f\u3002\u4ed6\u5728\u4f2f\u76ca\u7891\u524d\u656c\u4e86\u4e00\u7897\uff0c\u53c8\u5728\u7d27\u90bb\u7684\u7891\u524d\u653e\u4e86\u6574\u575b\u3002\u968f\u540e\u62cd\u5f00\u624b\u8fb9\u4e00\u575b\uff0c\u72ec\u996e\u8d77\u6765\u3002<\/p>\n\n<p>\u5c71\u4e0b\u5f20\u706f\u7ed3\u5f69\uff0c\u98ce\u4e2d\u4f9d\u7a00\u80fd\u542c\u89c1\u65cf\u4eba\u4eec\u7684\u6b22\u547c\u3002\u4ed6\u542c\u4e86\u7247\u523b\uff0c\u8d77\u8eab\u91cd\u65b0\u6361\u8d77\u6bdb\u5dfe\uff0c\u64e6\u62ed\u5c71\u5c97\u4e0a\u4e00\u5ea7\u5ea7\u9759\u9ed8\u7684\u77f3\u7891\u3002\u8fd9\u4e9b\u7891\u4e0a\u523b\u7740\u6bcf\u4f4d\u5f52\u5c71\u901d\u8005\u7684\u751f\u5e73\uff0c\u6709\u4e9b\u662f\u4ed6\u4eec\u7684\u5bb6\u4eba\u523b\u5199\uff0c\u66f4\u591a\u5219\u51fa\u81ea\u5927\u79b9\u4e4b\u624b\u3002<\/p>\n\n<p>\u4ed6\u6469\u6332\u7740\u77f3\u7891\u4e0a\u6591\u9a73\u7684\u6587\u5b57\uff0c\u98ce\u4f4e\u4f4e\u7a7f\u884c\uff0c\u8bc9\u8bf4\u7740\u90a3\u4e9b\u672a\u8bb2\u5b8c\u7684\u6545\u4e8b\u548c\u672a\u8bf4\u5b8c\u7684\u5fc3\u613f\u3002<\/p>\n\n<p>\u7891\u6797\u5e7d\u5e7d\uff0c\u770b\u4e0d\u89c1\u5c3d\u5934\u3002\u604d\u60da\u95f4\uff0c\u90a3\u4e9b\u9065\u8fdc\u7684\u8eab\u5f71\u53c8\u6d6e\u73b0\u51fa\u6765\u2026\u2026<\/p>\n\n \n\n<p>\u4e94\u767e\u5e74\u524d\uff0c\u4ed6\u548c\u670b\u53cb\u4eec\u4ece\u9ad8\u5929\u4e4b\u4e0a\u6765\u5230\u51e1\u95f4\u3002<\/p>\n\n<p>\u90a3\u65e5\u6070\u9022\u5f52\u5c71\u4e00\u65cf\u7684\u201c\u7834\u6653\u8282\u201d\u3002\u6d3b\u4e86\u51e0\u767e\u5e74\u7684\u795e\u804c\u8005\u4eec\u73a9\u5fc3\u5927\u8d77\uff0c\u6536\u4e86\u795e\u901a\uff0c\u6df7\u5165\u51e1\u4eba\u7684\u6500\u767b\u8bd5\u70bc\u3002\u867d\u8bf4\u597d\u4e0d\u8981\u8138\u5730\u8d62\u4e86\u4eba\u7c7b\uff0c\u5374\u4e5f\u5728\u8d5b\u540e\u7684\u5c71\u9876\u665a\u5bb4\u4e0a\u8d25\u7ed9\u4e86\u5f52\u5c71\u4e4b\u6c11\u70bd\u70c8\u7684\u743c\u6d46\u3002\u6700\u7ec8\uff0c\u5728\u76d8\u53e4\u5927\u795e\u6240\u5316\u7684\u7834\u6653\u5723\u5c71\u4e4b\u5dc5\uff0c\u6240\u6709\u4eba\u4e0d\u5206\u5f7c\u6b64\uff0c\u4e0d\u95ee\u51fa\u5904\uff0c\u4e8e\u7bdd\u706b\u8fb9\u9189\u91ba\u91ba\u5730\u5367\u6210\u4e00\u56e2\u3002\u5f53\u671d\u9633\u51b2\u7834\u4e91\u971e\u4e4b\u9645\uff0c\u5927\u79b9\u5728\u55a7\u95f9\u4e2d\u9192\u6765\uff0c\u88ab\u7c07\u62e5\u7740\u6765\u5230\u5d16\u8fb9\uff0c\u773a\u671b\u6574\u4e2a\u5efa\u6728\u3002<\/p>\n\n<p>\u8fd9\u98ce\u666f\u5e76\u4e0d\u5947\u7279\uff0c\u751a\u81f3\u53ef\u8bf4\u662f\u7565\u900a\u4e8e\u5728\u5012\u60ac\u5929\u4e0a\u4fef\u77b0\u4eba\u95f4\u3002<\/p>\n\n<p>\u53ef\u6b64\u65f6\u4ed6\u4eec\u88ab\u5f52\u5c71\u4e4b\u6c11\u7684\u6df3\u6734\u548c\u70ed\u60c5\u62e5\u62b1\u7740\u3002\u9633\u5149\u5f88\u8000\u773c\uff0c\u98ce\u5f90\u5f90\u62c2\u8fc7\uff0c\u5c71\u811a\u4e0b\u7684\u708a\u70df\u6328\u5bb6\u6328\u6237\u6162\u6162\u5347\u817e\u8d77\u6765\u3002\u5ffd\u7136\u4e4b\u95f4\uff0c\u4ed6\u7406\u89e3\u4e86\u76d8\u53e4\u5927\u795e\u3002<\/p>\n\n<p>\u8fd9\u786e\u5b9e\u662f\u4f1f\u5927\u7684\u5947\u89c2\u3002<\/p>\n\n\n\n<p>\u4f46\u8fd9\u4e9b\u5947\u89c2\u5f88\u5feb\u5c31\u56e0\u5947\u8ff9\u4e4b\u6218\u800c\u5d29\u788e\u3002<\/p>\n\n<p>\u6714\u5f15\u7206\u4e86\u7a7a\u95f4\u5947\u8ff9\uff0c\u7d0a\u6d41\u81ea\u5012\u60ac\u5929\u503e\u6cfb\u800c\u4e0b\uff0c\u5377\u8d70\u4e86\u96c4\u5947\u7684\u96d5\u50cf\uff0c\u6e29\u6696\u7684\u6c11\u623f\uff0c\u4ee5\u53ca\u90a3\u4e9b\u548c\u4ed6\u4eec\u4e00\u8d77\u75db\u5feb\u7545\u996e\u770b\u8fc7\u65e5\u51fa\u7684\u4eba\u3002<\/p>\n\n<p>\u4e3a\u4e86\u963b\u6b62\u707e\u5bb3\u8513\u5ef6\uff0c\u6768\u622c\u4ee5\u8eab\u5c01\u5370\u5947\u8ff9\uff0c\u957f\u7720\u4e8e\u4e91\u6d77\u3002\u7559\u5728\u5730\u9762\u7684\u795e\u804c\u8005\u4eec\u5219\u96c6\u7ed3\u4e86\u5f52\u5c71\u65cf\u7684\u6218\u58eb\uff0c\u8a93\u6b7b\u4e0e\u7d0a\u6d41\u6297\u4e89\u3002\u6709\u4eba\u529b\u7aed\u5012\u4e0b\uff0c\u4ed6\u4eec\u7684\u5b69\u5b50\u4fbf\u63a5\u8fc7\u4f7f\u547d\u518d\u5ea6\u524d\u884c\uff0c\u53ea\u4e3a\u5b88\u62a4\u8eab\u540e\u7684\u5bb6\u56ed\u3002<\/p>\n\n<p>\u8fd9\u4e00\u5b88\uff0c\u5c31\u662f\u4e94\u767e\u5e74\u3002<\/p>\n\n\n\n<p>\u4e94\u767e\u5e74\u540e\uff0c\u9ad8\u7a7a\u4e0a\u7684\u7d0a\u6d41\u4e4b\u6d77\u4ecd\u7b3c\u7f69\u7740\u5efa\u6728\uff0c\u4f46\u5176\u95f4\u5df2\u5efa\u8d77\u4e86\u4e00\u5ea7\u5ea7\u54e8\u7ad9\u3002\u5341\u51e0\u4ee3\u4eba\u524d\u8d74\u540e\u7ee7\uff0c\u4ed6\u4eec\u6740\u51fa\u4e86\u751f\u8def\uff0c\u8fd8\u8981\u5e87\u4f51\u7740\u540e\u6765\u8005\u7ee7\u7eed\u5411\u4e0a\u7a81\u7834\u3002\u4ed6\u4eec\u4e0d\u4ec5\u8981\u4ece\u8fd9\u5929\u707e\u4e4b\u5883\u4e2d\u593a\u53d6\u751f\u5b58\u7684\u7269\u8d44\uff0c\u593a\u56de\u5c5e\u4e8e\u4ed6\u4eec\u7684\u8fc7\u53bb\uff0c\u8fd8\u8981\u4e86\u89e3\u4ed6\u4eec\u7684\u654c\u4eba\uff0c\u5f7b\u5e95\u6d88\u706d\u7d0a\u6d41\u3002<\/p>\n\n<p>\u5f52\u5c71\u4e4b\u6c11\uff0c\u6c38\u4e0d\u540e\u9000\u3002<\/p>\n\n<p>\u5982\u4eca\uff0c\u7d0a\u6d41\u6cbb\u7406\u7ec8\u4e8e\u6709\u4e86\u7a81\u7834\u6027\u7684\u8fdb\u5c55\u3002\u7ecf\u8fc7\u6570\u4ee3\u52aa\u529b\uff0c\u80fd\u591f\u51c0\u5316\u7d0a\u6d41\u7684\u201c\u9f0e\u201d\uff0c\u5728\u4e0d\u5468\u574a\u7684\u7089\u706b\u4e2d\u6dec\u70bc\u51fa\u6765\u3002\u9f0e\u4fdd\u62a4\u6751\u843d\u4e0d\u53d7\u4fb5\u5bb3\uff0c\u5927\u79b9\u4e5f\u501f\u6b64\u7387\u6218\u58eb\u4eec\u7a81\u7834\u4e86\u7d0a\u6d41\u4e4b\u6d77\u7684\u66f4\u4e0a\u5c42\u3002<\/p>\n\n<p>\u4f46\u8fd9\u6761\u8def\u7684\u7ec8\u70b9\u4f1a\u662f\u4ec0\u4e48\u5462\uff1f<\/p>\n\n<p>\u201c\u5343\u4e07\u4eba\u7684\u547c\u58f0\uff0c\u6bd4\u7d0a\u6d41\u66f4\u9707\u8033\u6b32\u804b\u2026\u2026\u201d\u5927\u79b9\u5bf9\u7740\u7891\u6797\u4f4e\u8bed\uff0c\u58f0\u97f3\u6563\u5728\u98ce\u91cc\uff0c\u201c\u6211\u5f15\u5927\u4f19\u513f\u6cbb\u6c34\u4e00\u751f\uff0c\u53ef\u5982\u679c\u7ec8\u70b9\u4ecd\u662f\u4e00\u7247\u6c6a\u6d0b\u2026\u2026\u201d<\/p>\n\n<p>\u4ed6\u95ed\u4e0a\u773c\uff0c\u58f0\u97f3\u66f4\u8f7b\u4e86\uff1a<\/p>\n\n<p>\u201c\u54ce\u2026\u2026\u6211\u8981\u771f\u662f\u4e2a\u795e\u4ed9\u5c31\u597d\u4e86\u3002\u201d<\/p>\n\n<p>\u7834\u6653\u5723\u5c71\u9759\u9ed8\u65e0\u8a00\uff0c\u5929\u5149\u660f\u6697\u3002\u800c\u5c31\u5728\u6b64\u523b\u2014\u2014<\/p>\n\n<p>\u201c\u562d\u2014\u2014\uff01\u201d<\/p>\n\n<p>\u4e00\u58f0\u5de8\u54cd\u6495\u88c2\u66ae\u8272\uff0c\u62c9\u56de\u5927\u79b9\u98d8\u6563\u7684\u601d\u7eea\u3002<\/p>\n\n<p>\u201c\u770b\uff01\u8001\u4f19\u8ba1\u4eec\uff01\u201d\u5927\u79b9\u7ad9\u5728\u5149\u6d01\u7684\u77f3\u7891\u524d\uff0c\u62ac\u5934\u770b\u5411\u5929\u7a7a\uff0c\u201c\u5b69\u5b50\u4eec\u653e\u65b0\u5e74\u70df\u82b1\u4e86\uff01\u201d<\/p>\n\n<p>\u4e00\u6735\u5de8\u5927\u7684\u83b2\u82b1\u5728\u7a7a\u4e2d\u7efd\u653e\uff0c\u54ea\u5412\u8e29\u7740\u98ce\u706b\u8f6e\u7a7f\u8d8a\u5929\u9645\uff0c\u6df7\u5929\u7eeb\u62d6\u51fa\u4e00\u9053\u7ea2\u971e\uff0c\u843d\u5165\u4eba\u7fa4\u4e4b\u4e2d\uff0c\u6fc0\u8d77\u7a1a\u7ae5\u4eec\u7684\u6b22\u817e\u3002\u53e6\u4e00\u8fb9\uff0c\u86a9\u597c\u4e5f\u4e0d\u7518\u793a\u5f31\uff0c\u6210\u7247\u7684\u70df\u82b1\u5347\u817e\u800c\u8d77\uff0c\u5f62\u540c\u5404\u8272\u5175\u6208\u4ea4\u51fb\u3002<\/p>\n\n<p>\u53ef\u7d27\u63a5\u7740\uff0c\u6f06\u9ed1\u7684\u7089\u70df\u7ffb\u6eda\u800c\u4e0a\uff0c\u5c06\u524d\u4e24\u8005\u7edf\u7edf\u201c\u541e\u6ca1\u201d\u3002\u5c71\u4e0b\u4f20\u6765\u9635\u9635\u54c4\u7b11\uff0c\u5927\u79b9\u9690\u7ea6\u542c\u89c1\u4e86\u4eba\u4eec\u5927\u558a\u201c\u592a\u4e8c\u201d\u7684\u540d\u5b57\u3002<\/p>\n\n<p>\u7089\u70df\u5728\u7a7a\u4e2d\u567c\u91cc\u556a\u5566\u4e00\u901a\u4e71\u54cd\uff0c\u968f\u5373\u5316\u4f5c\u5404\u5f0f\u5404\u6837\u7684\u70df\u82b1\u51b2\u5411\u4e86\u5929\u7a7a\u2014\u2014\u90a3\u662f\u6218\u58eb\u8eab\u4e0a\u7684\u76d4\u7532\uff0c\u662f\u5b69\u5b50\u624b\u4e2d\u7684\u98ce\u8f66\uff0c\u662f\u4e0d\u5468\u574a\u98d8\u626c\u7684\u65cc\u65d7\u2026\u2026\u6700\u7ec8\uff0c\u6240\u6709\u7684\u70df\u82b1\u4ea4\u878d\u6c47\u805a\uff0c\u5f62\u6210\u4e86\u4e00\u5c0a\u77d7\u7acb\u5929\u5730\u7684\u5de8\u9f0e\u3002<\/p>\n\n<p>\u4e07\u7269\u7686\u4e8e\u6b64\u523b\u5931\u4e86\u989c\u8272\u3002<\/p>\n\n \n\n<p>\u201c\u6709\u4ec0\u4e48\u597d\u62c5\u5fc3\u7684\u3002\u201d\u5927\u79b9\u5fc3\u4e2d\u7684\u6d4a\u6c14\u5ffd\u7136\u6d88\u6563\u4e86\uff0c\u4ed6\u75db\u5feb\u5730\u5e72\u5b8c\u4e86\u575b\u4e2d\u5269\u4e0b\u7684\u9152\uff0c\u201c\u90a3\u4e48\u96be\u7684\u8def\u90fd\u8d70\u8fc7\u6765\u4e86\uff0c\u7ea6\u5b9a\u597d\u7684\u4e8b\u60c5\u54b1\u4eec\u4e5f\u90fd\u505a\u5230\u4e86\u3002\u4ee5\u540e\uff0c\u5b69\u5b50\u4eec\u4f1a\u505a\u7684\u6bd4\u54b1\u4eec\u66f4\u597d\u3002\u201d<\/p>\n\n<p>\u4ed6\u7acb\u8eab\u5929\u5730\u4e4b\u95f4\uff0c\u4ef0\u671b\u7740\u7eda\u70c2\u7684\u591c\u7a7a\u3002\u8eab\u540e\u662f\u575a\u97e7\u633a\u7acb\u7684\u7891\u6797\uff0c\u8eab\u524d\u662f\u5f52\u5c71\u4e00\u65cf\u7ef5\u5ef6\u4e0d\u7184\u7684\u706f\u706b\u3002<\/p>\n\n\n\n<p><b><\/b><\/p><p><b><font color=\"#007ac0\">\u6614\u9014\u5f52\u4eba<\/font><\/b><\/p>\n<p>\u7d0a\u6d41\u81ea\u5929\u800c\u964d\uff0c\u90a3\u6211\u4eec\u5c31\u767b\u4e0a\u9ad8\u5929\uff0c\u53bb\u5f80\u5b83\u7684\u6e90\u5934\uff01\u7eb5\u4f7f\u524d\u7ebf\u6b8b\u9177\uff0c\u6d4a\u6d6a\u53cd\u590d\uff0c\u5f52\u5c71\u7684\u6218\u58eb\u6c38\u4e0d\u540e\u9000\u3002<\/p>\n\n<p>\u2014\u2014\u5f52\u5c71\u6218\u58eb \u4f2f\u76ca  \u5893\u5fd7\u94ed<\/p>\n\n<p>\u201c\u7d0a\u6d41\u517d\u201d\u5de8\u5927\u7684\u8eab\u4f53\u8f70\u7136\u5012\u4e0b\uff0c\u4f2f\u76ca\u7acb\u523b\u638f\u51fa\u5bb9\u5668\uff0c\u9501\u4f4f\u4e86\u56db\u6563\u9003\u9038\u7684\u80fd\u91cf\uff0c\u8fd9\u662f\u8981\u5e26\u56de\u4e0d\u5468\u574a\u7814\u7a76\u7684\u91cd\u8981\u6837\u672c\u3002<\/p>\n\n<p>\u7b49\u8fd9\u4e00\u5207\u505a\u5b8c\uff0c\u4ed6\u6491\u7740\u65ad\u88c2\u7684\u957f\u77db\uff0c\u8131\u529b\u8dcc\u5750\u5728\u5730\u3002<\/p>\n\n<p>\u4e24\u5929\u4e24\u591c\u7684\u93d6\u6218\u7ec8\u4e8e\u7ed3\u675f\u4e86\uff0c\u4e00\u5207\u90fd\u5b89\u9759\u4e86\u4e0b\u6765\u3002\u5728\u8fd9\u5ea7\u88ab\u7d0a\u6d41\u541e\u6ca1\u7684\u524d\u54e8\u7ad9\u4e2d\uff0c\u53ea\u5269\u4ed6\u81ea\u5df1\u7684\u5598\u606f\u58f0\u3002\u4ed6\u8fd9\u624d\u5f00\u59cb\u6253\u91cf\u201c\u7d0a\u6d41\u517d\u201d\u7684\u771f\u8eab\u2014\u2014\u4e00\u5ea7\u88ab\u7d0a\u6d41\u88f9\u631f\u7684\u78e8\u574a\u548c\u51e0\u5934\u5df2\u7ecf\u786c\u5316\u7684\u9aa1\u5b50\u3002<\/p>\n\n<p>\u6709\u78e8\u574a\uff0c\u90a3\u5c31\u8fd8\u6709\u7cae\uff0c\u80fd\u586b\u809a\u5b50\uff0c\u8fd8\u80fd\u917f\u9152\u3002<\/p>\n\n<p>\u771f\u597d\u554a\uff0c\u53ef\u4ed6\u6015\u662f\u6ca1\u8fd9\u4e2a\u53e3\u798f\u4e86\u3002<\/p>\n\n<p>\u4f2f\u76ca\u7d27\u63e1\u65ad\u77db\u7684\u624b\u98a4\u6296\u4e0d\u6b62\uff0c\u773c\u524d\u7684\u78e8\u574a\u4e5f\u5f00\u59cb\u91cd\u5f71\u2014\u2014\u4e0d\u77e5\u4f1a\u5426\u6709\u4eba\u77e5\u9053\uff0c\u8fd9\u91cc\u66fe\u6709\u4f4d\u6218\u58eb\u6218\u6597\u81f3\u6700\u540e\u4e00\u523b\uff1f\u4e0d\u77e5\u59da\u59dc\u6b64\u65f6\uff0c\u53c8\u5728\u505a\u4ec0\u4e48\u5462\uff1f<\/p>\n\n<p>\u201c\u597d\u5927\u7684\u730e\u7269\uff0c\u4f2f\u76ca\uff0c\u4eca\u5e74\u7684\u5934\u529f\u975e\u4f60\u83ab\u5c5e\u4e86\uff01\u201d<\/p>\n\n<p>\u6d2a\u4eae\u7684\u58f0\u97f3\u7834\u5f00\u9ed1\u6697\uff0c\u5149\u8f89\u7167\u4eae\u4e86\u6218\u58eb\u67d3\u8840\u7684\u8138\u3002<\/p>\n\n<p>\u201c\u9996\u9886\uff01\u201d<\/p>\n\n<p>\u4f2f\u76ca\u4e0d\u987e\u4f24\u53e3\u7684\u75bc\u75db\uff0c\u6323\u624e\u8d77\u8eab\uff0c\u7a81\u7136\u53c8\u7d27\u5f20\u5730\u73af\u987e\u56db\u5468\u6d8c\u52a8\u7684\u7d0a\u6d41\u3002\u4ed6\u542c\u89c1\u4e86\u201c\u7ab8\u7ab8\u7aa3\u7aa3\u201d\u7684\u58f0\u54cd\uff0c\u4f46\u56db\u91ce\u660f\u6c89\uff0c\u4ec0\u4e48\u4e5f\u6ca1\u6709\uff0c\u90a3\u58f0\u54cd\u6765\u81ea\u4ed6\u4f53\u5185\uff0c\u968f\u7740\u4ed6\u7684\u8840\u7ba1\u9f13\u52a8\u3002<\/p>\n\n<p>\u7d0a\u6d41\u7684\u4fb5\u8680\u6b63\u5728\u52a0\u5267\uff0c\u4ed6\u542c\u89c1\u4e86\u540c\u4f34\u7684\u547c\u5524\uff0c\u53c8\u4eff\u4f5b\u770b\u89c1\u59bb\u5b50\u59da\u59dc\u5728\u5de5\u574a\u7089\u706b\u65c1\u5fae\u7b11\u62db\u624b\u3002<\/p>\n\n<p>\u4ed6\u77e5\u9053\uff0c\u81ea\u5df1\u7684\u65f6\u95f4\u4e0d\u591a\u4e86\u3002<\/p>\n\n<p>\u2014\u2014\u90a3\u662f\u7d0a\u6d41\u7684\u4fb5\u8680\u6b63\u5728\u52a0\u5267\u3002\u4f2f\u76ca\u4eff\u4f5b\u770b\u89c1\u59bb\u5b50\u59da\u59dc\u5728\u5de5\u574a\u7089\u706b\u65c1\u5fae\u7b11\u62db\u624b\uff0c\u968f\u540e\u4ed6\u597d\u50cf\u770b\u5230\u4e86\u727a\u7272\u5728\u7d0a\u6d41\u4e4b\u6d77\u4e2d\u7684\u540c\u80de\u4eec\uff0c\u4ed6\u8fd8\u4f3c\u4e4e\u611f\u53d7\u5230\u4e86\u90a3\u4e9b\u88ab\u7d0a\u6d41\u75c5\u7f20\u8eab\u591a\u5e74\u7684\u524d\u8f88\u4eec\uff0c\u7126\u8e81\u3001\u504f\u6267\u3001\u559c\u6012\u65e0\u5e38\u2026\u2026\u4ed6\u7684\u5927\u8111\u4f3c\u4e4e\u88ab\u5207\u6210\u4e86\u8bb8\u591a\u5947\u602a\u7684\u7247\u6bb5\uff0c\u4e00\u79cd\u6781\u96be\u63cf\u8ff0\u7684\u9519\u4f4d\u611f\u8ba9\u4ed6\u5206\u5916\u4e0d\u5b89\u3002<\/p>\n\n<p>\u4ed6\u77e5\u9053\uff0c\u81ea\u5df1\u7684\u65f6\u95f4\u4e0d\u591a\u4e86\u3002<\/p>\n\n \n\n<p>\u201c\u522b\u4e71\u52a8\u3002\u201d<\/p>\n\n<p>\u5927\u79b9\u4e0a\u524d\uff0c\u8c27\u6d41\u4e4b\u529b\u8986\u4e0a\u4f2f\u76ca\u7684\u521b\u4f24\uff0c\u4f24\u53e3\u4e2d\u5e7d\u6697\u7684\u80fd\u91cf\u62bd\u6410\u707c\u70eb\uff0c\u5728\u51c0\u5316\u4e2d\u5636\u9e23\u6d88\u6563\u3002<\/p>\n\n<p>\u201c\u9996\u9886\uff0c\u6211\u2026\u2026\u201d<\/p>\n\n<p>\u201c\u770b\u89c1\u5730\u9762\u7684\u706b\u5149\u4e86\u5417\uff1f\u59da\u59dc\u53ef\u662f\u628a\u57cb\u4e86\u5341\u5e74\u7684\u9648\u917f\u90fd\u8d77\u51fa\u6765\u4e86\uff0c\u5c31\u7b49\u7740\u4f60\u56de\u53bb\u5462\uff01\u201d<\/p>\n\n<p>\u900f\u8fc7\u7d0a\u6d41\uff0c\u4f2f\u76ca\u771f\u7684\u770b\u5230\u4e86\u9690\u9690\u7ef0\u7ef0\u7684\u5149\u6655\u3002\u4ed6\u60f3\u5230\u4e86\u59bb\u5b50\u94f8\u9020\u5de5\u574a\u4e2d\u5e38\u5e74\u4e0d\u7184\u7684\u7089\u706b\uff0c\u7edd\u671b\u7684\u8eab\u5fc3\u88ab\u6ce8\u5165\u4e00\u4e1d\u529b\u6c14\u3002<\/p>\n\n<p>\u7136\u800c\u7d0a\u6d41\u9aa4\u7136\u72c2\u66b4\uff0c\u5982\u5de8\u6d6a\u88f9\u631f\u65e0\u6570\u602a\u7269\u6251\u6765\uff0c\u77ac\u95f4\u541e\u6ca1\u4e86\u5fae\u5149\u3002\u5927\u79b9\u5c06\u4f2f\u76ca\u62a4\u5728\u8eab\u540e\uff0c\u8bd5\u56fe\u5288\u5f00\u4e00\u6761\u751f\u8def\uff0c\u4f46\u7d0a\u6d41\u517d\u6e90\u6e90\u4e0d\u7edd\uff0c\u4ed6\u4eec\u8d70\u7684\u6108\u53d1\u5403\u529b\u3002<\/p>\n\n<p>\u4f2f\u76ca\u505c\u4e0b\u4e86\u811a\u6b65\u3002<\/p>\n\n<p>\u201c\u9996\u9886\uff0c\u522b\u7ba1\u6211\u4e86\uff0c\u6211\u8fd9\u8f88\u5b50\u5df2\u7ecf\u503c\u4e86\u3002\u201d<\/p>\n\n<p>\u201c\u4f60\u5c0f\u5b50\u624d\u591a\u5927\u5e74\u7eaa\uff0c\u5c31\u8bf4\u4e00\u8f88\u5b50\uff1f\u6211\u8fd8\u7ed9\u4f60\u6362\u8fc7\u5c3f\u88e4\u5462\uff01\u201d<\/p>\n\n<p>\u201c\u54b3\u54b3\u54b3\uff01\uff01\u201d\u4f2f\u76ca\u56e0\u5931\u8840\u800c\u82cd\u767d\u7684\u8138\u6b64\u523b\u6da8\u5f97\u901a\u7ea2\uff0c\u201c\u9996\u9886\uff0c\u6211\u4eec\u4e0d\u4e00\u6837\u2026\u2026\u201d<\/p>\n\n<p>\u201c\u6709\u4ec0\u4e48\u4e0d\u4e00\u6837\uff1f\u96be\u9053\u6211\u591a\u957f\u4e86\u4e00\u53ea\u773c\u775b\uff1f\u201d<\/p>\n\n<p>\u201c\u4f60\u662f\u795e\u4ed9\u2026\u2026\u201d\u4f2f\u76ca\u5c0f\u58f0\u561f\u56d4\u7740\u3002<\/p>\n\n<p>\u201c\u662f\u554a\uff0c\u6211\u662f\u795e\u4ed9\uff0c\u6240\u4ee5\u6293\u7d27\u6211\uff01\u201d<\/p>\n\n \n\n<p>\u5927\u79b9\u8f6c\u8eab\u6293\u4f4f\u4f2f\u76ca\u7684\u624b\u81c2\uff0c\u8eab\u540e\u62ab\u98ce\u626c\u8d77\uff0c\u51fb\u9000\u8fdb\u653b\u7684\u7d0a\u6d41\u517d\u3002\u4e00\u5c0a\u660e\u5149\u8d6b\u8d6b\u7684\u5de8\u9f0e\u9547\u538b\u800c\u4e0b\uff0c\u541e\u7eb3\u7740\u56db\u5468\u72c2\u66b4\u7684\u7d0a\u6d41\u3002\u8eab\u5904\u6f29\u6da1\u4e2d\u5fc3\u7684\u5927\u79b9\u88ab\u6495\u626f\u7740\uff0c\u5e7d\u6697\u7684\u7eb9\u8def\u5982\u626d\u66f2\u7684\u86c7\u866b\u722c\u4e0a\u4ed6\u7684\u8eab\u8eaf\u3002<\/p>\n\n<p>\u4ed6\u53c8\u4e00\u6b21\u770b\u5230\u4e86\u90a3\u7247\u7891\u6797\u3002\u4e00\u4ee3\u4ee3\u6218\u53cb\u4eec\u4e8e\u7891\u524d\u9759\u7acb\uff0c\u65e0\u58f0\u5730\u51dd\u671b\u5927\u79b9\u3002\u8089\u4f53\u7684\u75db\u695a\u6ca1\u6709\u6253\u5012\u4ed6\uff0c\u7d0a\u6d41\u7684\u4fb5\u8680\u4e5f\u4ece\u6ca1\u6709\u6539\u53d8\u4ed6\uff0c\u4f46\u4ed6\u4eec\u7684\u773c\u795e\u4f9d\u7136\u8ba9\u4ed6\u5fc3\u4e2d\u5927\u6078\uff0c\u60b2\u4e0d\u80fd\u5df2\u3002<\/p>\n\n<p>\u201c\u9996\u9886\uff0c\u8fd9\u6837\u4e0b\u53bb\u2026\u2026\u4f60\u7684\u8eab\u4f53\u4f1a\u88ab\u7d0a\u6d41\u6495\u88c2\u7684\uff01\u201d\u4f2f\u76ca\u62fc\u7740\u53d7\u4f24\u7684\u8eab\u4f53\uff0c\u51b2\u4e0a\u524d\u6765\u3002<\/p>\n\n<p>\u5927\u79b9\u604d\u7136\u56de\u795e\uff0c\u770b\u5230\u4f2f\u76ca\u7684\u773c\u7736\u4e2d\u84c4\u6ee1\u4e86\u6cea\u6c34\u3002\u4ed6\u626f\u51fa\u4e86\u4e00\u4e2a\u7b11\u8138\uff0c\u4ed6\u8bb8\u8bfa\u8fc7\uff0c\u4f1a\u5e26\u4ed6\u4eec\u8d70\u5411\u80dc\u5229\u3002<\/p>\n\n<p>\u201c\u4f60\u77e5\u9053\uff0c\u9c7c\u5728\u6cb8\u6c34\u91cc\u4f1a\u600e\u4e48\u6837\u5417\uff1f\u201d<\/p>\n\n<p>\u4f2f\u76ca\u6123\u4e86\u4e00\u4e0b\uff0c\u4e0b\u610f\u8bc6\u56de\u7b54\uff1a\u201c\u4f1a\u53d8\u6210\u9c7c\u6c64\uff1f\u201d<\/p>\n\n<p>\u201c\u4e0d\u5bf9\uff01<\/p>\n\n<p>\u201c\u662f\u4f1a\u98de\uff08\u6cb8\uff09\u817e\u8d77\u6765\uff0c\u54c8\u54c8\u54c8\u54c8\uff01\u201d<\/p>\n\n<p>\u968f\u7740\u5927\u79b9\u7684\u7b11\u58f0\uff0c\u5de8\u9f0e\u7ec8\u4e8e\u6da4\u51c0\u56db\u5468\u7ffb\u817e\u7684\u7d0a\u6d41\uff0c\u786c\u751f\u751f\u5f00\u8f9f\u51fa\u4e00\u6761\u901a\u9014\u3002\u5927\u79b9\u63d0\u643a\u7740\u4f2f\u76ca\uff0c\u98de\u817e\u800c\u8d77\uff0c\u56de\u5230\u4e86\u5929\u5149\u4e4b\u4e0b\u3002<\/p>\n\n \n\n<p>\u4f2f\u76ca\u6276\u4f4f\u8eab\u5f62\u8e09\u8dc4\u7684\u5927\u79b9\uff0c\u5374\u88ab\u4ed6\u8eab\u4e0a\u90a3\u4e9b\u4ecd\u5728\u8815\u52a8\u7684\u5e7d\u6697\u7eb9\u8def\u707c\u75db\u4e86\u624b\u638c\u3002<\/p>\n\n<p>\u5927\u79b9\u6df1\u5438\u4e86\u4e00\u53e3\u6c14\uff0c\u4f53\u8868\u7684\u7eb9\u8def\u9010\u6e10\u5e73\u606f\u6697\u6c89\uff0c\u4ed6\u770b\u7740\u4f2f\u76ca\u62c5\u5fe7\u7684\u773c\u795e\uff0c\u75b2\u60eb\u5730\u7b11\u9053\uff1a\u201c\u5c45\u7136\u8fd9\u4e48\u72fc\u72c8\u2026\u2026\u8981\u66ff\u6211\u4fdd\u5bc6\u554a\uff01\u201d<\/p>\n\n<p>\u6e29\u6696\u7684\u9633\u5149\u6d12\u843d\uff0c\u5e74\u9752\u7684\u9996\u9886\u4e0e\u6218\u58eb\u76f8\u4e92\u6400\u6276\u7740\uff0c\u8e0f\u4e0a\u5f52\u9014\u3002<\/p>\n\n<p>\u201c\u9996\u9886\u2026\u2026\u201d\u6218\u58eb\u770b\u7740\u5c71\u91ce\u95f4\u5347\u8d77\u7684\u8885\u8885\u708a\u70df\uff0c\u72b9\u8c6b\u4e86\u4e00\u4e0b\uff0c\u4f46\u8fd8\u662f\u4e0b\u5b9a\u4e86\u51b3\u5fc3\uff0c\u201c\u521a\u624d\u7684\u7b11\u8bdd\uff0c\u6211\u53ea\u80fd\u6253\u4e09\u5206\u3002\u201d<\/p>\n\n<p>\u201c\u6ee1\u5206\u4e94\u5206\uff1f\u201d<\/p>\n\n<p>\u201c\u4e00\u767e\u5206\u3002\u201d<\/p>\n\n<p>\u201c\u54b3\u54b3\u54b3\u2026\u2026\u6211\u4eec\u8fd8\u662f\u5feb\u8d76\u8def\u5427\u3002\u518d\u665a\u70b9\uff0c\u59da\u59dc\u4e00\u6ef4\u9152\u90fd\u4e0d\u4f1a\u7ed9\u54b1\u4eec\u5269\u4e86\uff01\u201d<\/p>\n\n<p><b><\/b><\/p><p><b><font color=\"#007ac0\">\u7089\u8fb9\u65e7\u4e8b<\/font><\/b><\/p>\n<p>\u201c\u6211\u548c\u4f60\u4eec\u8bf4\uff0c\u8fd9\u4e5d\u9f0e\u7684\u539f\u7406\u662f\u6e90\u4e8e\u6211\u7684\u592a\u592a\u592a\u592a\u592a\u5976\u5976\u2014\u2014\u59da\u59dc\uff01<\/p>\n\n<p>\u563f\uff0c\u6211\u6562\u5bf9\u9f0e\u53d1\u8a93\uff0c\u8fd9\u4e8b\u8981\u662f\u63ba\u4e86\u534a\u70b9\u5047\uff0c\u5c31\u8ba9\u6211\u8fd9\u8f88\u5b50\u90fd\u6253\u4e0d\u51fa\u597d\u5175\u5668\uff01\u8fd9\u6545\u4e8b\u554a\uff0c\u6765\u81ea\u6211\u592a\u592a\u592a\u592a\u592a\u5976\u5976\u90a3\u672c\u5feb\u6563\u67b6\u7684\u624b\u672d\u2026\u2026\u201d<\/p>\n\n\n\n<p>\u624b\u672d\u6b8b\u5377\uff08\u5176\u4e00\uff09<\/p>\n\n<p>XX\u5e74X\u6708X\u65e5\uff08\u5b57\u8ff9\u6a21\u7cca\u4e0d\u53ef\u8003\uff09<\/p>\n\n<p>\u9634\u5929<\/p>\n\n<p>\u542c\u8001\u4eba\u4eec\u8bf4\uff0c\u4ece\u524d\u5929\u9a7b\u539f\u4e0a\u662f\u80fd\u770b\u5230\u592a\u9633\u7684\uff0c\u81ea\u6253\u90a3\u8be5\u6b7b\u7684\u201c\u7d0a\u6d41\u201d\u6765\u4e86\uff0c\u54b1\u4eec\u8fd9\u513f\u5c31\u53ea\u5269\u4e0b\u9634\u5929\u4e86\u3002<\/p>\n\n<p>\u6211\u548c\u5f80\u5e38\u4e00\u6837\u6765\u5230\u94f8\u9020\u5de5\u574a\uff0c\u524d\u7ebf\u53c8\u9001\u6765\u4e86\u4e00\u6279\u88ab\u7d0a\u6d41\u4fb5\u8680\u62a5\u5e9f\u7684\u6b66\u5668\u3002\u8981\u4e0d\u662f\u5f53\u5e74\u5728\u6218\u573a\u4e0a\u88ab\u7d0a\u6d41\u541e\u4e86\u4e00\u6761\u817f\uff0c\u6211\u59da\u59dc\u73b0\u5728\u4e5f\u8be5\u5728\u524d\u7ebf\u62fc\u6740\u5462\uff01<\/p>\n\n<p>\u4e0d\u8fc7\uff0c\u8fd9\u4e9b\u6b66\u5668\u4e5f\u4e0d\u662f\u597d\u5bf9\u4ed8\u7684\uff0c\u85cf\u5728\u91cc\u5934\u7684\u7d0a\u6d41\u968f\u65f6\u53ef\u80fd\u66b4\u52a8\u4f24\u4eba\u3002<\/p>\n\n<p>\u6211\u628a\u6b8b\u5175\u4e00\u80a1\u8111\u6295\u8fdb\u7089\u5b50\u91cc\uff0c\u52a0\u8db3\u4e86\u706b\u529b\u731b\u70e7\uff0c\u628a\u91cc\u9762\u7684\u7d0a\u6d41\u6b8b\u6e23\u7edf\u7edf\u70e7\u5316\u4e86\u3002\u5c31\u7b97\u5076\u5c14\u9047\u5230\u51e0\u8d77\u7d0a\u6d41\u66b4\u52a8\u7684\u4e8b\u4ef6\uff0c\u6211\u624b\u91cc\u7684\u9524\u5b50\u4e5f\u4e0d\u662f\u5403\u7d20\u7684\uff01<\/p>\n\n<p>\u4f2f\u76ca\u8fd9\u5bb6\u4f19\u6765\u53d6\u91cd\u94f8\u597d\u7684\u5175\u5668\uff0c\u53c8\u548c\u6211\u626f\u4e9b\u6709\u7684\u6ca1\u7684\u3002\u8bf4\u4ec0\u4e48\u817f\u7638\u4e86\u6ca1\u5173\u7cfb\uff0c\u5f52\u5c71\u4eba\u4ece\u4e0d\u670d\u8f93\u3002<\/p>\n\n<p>\u5565\u610f\u601d\uff1f\u5570\u91cc\u5427\u55e6\u7684\uff0c\u70e6\u6b7b\u4e86\uff01<\/p>\n\n<p>\u96be\u9053\u2026\u2026\u662f\u60f3\u548c\u6211\u70ab\u8000\u4ed6\u80fd\u7ee7\u7eed\u8ddf\u7740\u9996\u9886\u6253\u4ed7\uff1f<\/p>\n\n \n\n<p>\u624b\u672d\u6b8b\u5377\uff08\u5176\u4e8c\uff09<\/p>\n\n<p>XX\u5e74X\u6708X\u65e5\uff08\u5b57\u8ff9\u6a21\u7cca\u4e0d\u53ef\u8003\uff09<\/p>\n\n<p>\u9634\u5929\u3001\u5927\u98ce<\/p>\n\n<p>\u6218\u53cb\u4eec\u5728\u524d\u7ebf\u6218\u6597\uff0c\u9662\u5b50\u91cc\u7684\u5b69\u5b50\u4eec\u603b\u56f4\u7740\u6211\u6253\u8f6c\u3002\u53ef\u8fd9\u51e0\u5929\u5916\u5934\u7684\u98ce\u568e\u5f97\u4eba\u5fc3\u614c\uff0c\u4ed6\u4eec\u665a\u4e0a\u5bb3\u6015\u5f97\u7761\u4e0d\u7740\u3002<\/p>\n\n<p>\u6211\u5c31\u7528\u5de5\u574a\u91cc\u7528\u5269\u7684\u5e9f\u6599\uff0c\u6572\u6572\u6253\u6253\u505a\u4e86\u4e2a\u9542\u7a7a\u3001\u591a\u5c42\u7ed3\u6784\u7684\u94c1\u7403\u3002<\/p>\n\n<p>\u72c2\u98ce\u704c\u8fdb\u90a3\u4e9b\u5b54\u6d1e\uff0c\u5728\u91cc\u5934\u6253\u7740\u65cb\u513f\u6d41\u52a8\uff0c\u88ab\u90a3\u4e9b\u5f27\u9762\u5f15\u7740\u3001\u7406\u987a\u4e86\uff0c\u5c31\u4e0d\u4f1a\u778e\u568e\u4e86\uff0c\u53cd\u800c\u4f1a\u53d1\u51fa\u4e00\u79cd\u4f4e\u6c89\u3001\u6d51\u539a\u7684\u55e1\u9e23\u58f0\uff0c\u50cf\u6447\u7bee\u66f2\u4f3c\u7684\uff0c\u542c\u7740\u8212\u5766\u3002\u6211\u7ed9\u5b83\u53d6\u4e86\u4e2a\u540d\u5b57\u53eb\u201c\u98ce\u94c3\u7403\u201d\u3002<\/p>\n\n<p>\u5a03\u5a03\u4eec\u603b\u7b97\u7761\u8e0f\u5b9e\u4e86\uff0c\u6211\u6b63\u4e50\u5462\uff0c\u6ca1\u6210\u60f3\u9996\u9886\u7a81\u7136\u6765\u4e86\uff01\u8bf4\u662f\u542c\u89c1\u6211\u8fd9\u91cc\u6709\u602a\u58f0\uff0c\u8fc7\u6765\u77a7\u77a7\u3002<\/p>\n\n<p>\u5413\u6b7b\u6211\u4e86\uff0c\u8fd8\u4ee5\u4e3a\u662f\u6211\u94f8\u9020\u65f6\u6ca1\u7a7f\u9632\u62a4\u670d\u88ab\u6293\u5305\u4e86\uff01<\/p>\n\n<p>\u6211\u7ed9\u9996\u9886\u6bd4\u5212\u7740\u89e3\u91ca\u98ce\u94c3\u7403\u91cc\u5934\u7684\u95e8\u9053\uff0c\u9996\u9886\u542c\u5b8c\u540e\uff0c\u773c\u775b\u4e00\u4e0b\u5b50\u5c31\u4eae\u4e86\uff01\u8bf4\u6211\u8fd9\u4e2a\u5c0f\u73a9\u610f\u513f\uff0c\u7ed9\u89e3\u51b3\u7d0a\u6d41\u63d0\u4f9b\u4e86\u4e00\u4e2a\u5168\u65b0\u7684\u65b9\u5411\uff01\u8fd8\u9080\u8bf7\u6211\u52a0\u5165\u4ec0\u4e48\u201c\u7d0a\u6d41\u4e13\u6cbb\u5de5\u7a0b\u201d\u3002<\/p>\n\n<p>\u6b63\u5f53\u6211\u88ab\u5938\u5f97\u627e\u4e0d\u5230\u5317\u7684\u65f6\u5019\uff0c\u77a5\u89c1\u95e8\u53e3\u4f2f\u76ca\u53c8\u6765\u4e86\u3002\u6211\u8d76\u7d27\u628a\u4ed6\u62fd\u8fc7\u6765\u5411\u9996\u9886\u544a\u72b6\uff0c\u63a7\u8bc9\u4ed6\u8fd9\u6bb5\u65f6\u95f4\u8001\u662f\u627e\u6211\u832c\uff01<\/p>\n\n<p>\u9996\u9886\u76b1\u7740\u7709\u95ee\uff1a\u201c\u4f60\u4e00\u4e2a\u5927\u5c0f\u4f19\u5b50\uff0c\u5929\u5929\u5f80\u59d1\u5a18\u5bb6\u8dd1\uff0c\u662f\u4ec0\u4e48\u610f\u601d\uff1f\u201d<\/p>\n\n<p>\u4f2f\u76ca\u8fd9\u5bb6\u4f19\u7684\u8138\u77ac\u95f4\u6da8\u5f97\u901a\u7ea2\uff0c\u4e00\u4e0b\u7529\u5f00\u4e86\u6211\u7684\u624b\uff0c\u5f80\u6211\u6000\u91cc\u585e\u4e86\u4e1c\u897f\u5c31\u8dd1\u3002\u6211\u62ff\u51fa\u6765\u4e00\u770b\uff0c\u7adf\u7136\u662f\u53cc\u94f8\u9020\u624b\u5957\uff0c\u8fd8\u6709\u4e00\u6367\u852b\u4e86\u5427\u5527\u7684\u91ce\u82b1\u3002<\/p>\n\n<p>\u8fd9\u4e0b\u6211\u5f7b\u5e95\u61c2\u4e86\uff0c\u53ea\u611f\u89c9\u8138\u4e0a\u70e7\u5f97\u53d1\u70eb\u3002<\/p>\n\n<p>\u6211\u5077\u5077\u53c8\u6253\u91cf\u4e86\u4e00\u4e0b\u4f2f\u76ca\u9003\u8dd1\u7684\u80cc\u5f71\uff0c\u8fd9\u5bb6\u4f19\u4eca\u5929\u597d\u50cf\u7279\u610f\u636f\u996c\u8fc7\uff0c\u6a21\u6837\u5012\u4e5f\u4e0d\u8d56\u3002<\/p>\n\n \n\n<p>\u624b\u672d\u6b8b\u5377\uff08\u5176\u4e09\uff09<\/p>\n\n<p>XX\u5e74X\u6708X\u65e5\uff08\u5b57\u8ff9\u6a21\u7cca\u4e0d\u53ef\u8003\uff09<\/p>\n\n<p>\u5927\uff01\u6674\uff01\u5929\uff01<\/p>\n\n<p>\u4eca\u5929\u53cc\u559c\u4e34\u95e8\uff01\uff01<\/p>\n\n<p>\u7b2c\u4e00\u4ef6\u559c\u4e8b\uff0c\u6211\u6d3b\u4e86\u8fd9\u4e48\u591a\u5e74\uff0c\u603b\u7b97\u662f\u89c1\u5230\u201c\u592a\u9633\u201d\u4e86\u3002\u5c31\u5728\u5934\u9876\uff0c\u900f\u8fc7\u4e91\u5c42\u7167\u4e0b\u6765\uff0c\u660e\u6643\u6643\u7684\u4e00\u5927\u56e2\uff01\u9996\u9886\u8bf4\uff0c\u662f\u6211\u4eec\u201c\u7d0a\u6d41\u4e13\u6cbb\u5de5\u7a0b\u201d\u4e4b\u524d\u6253\u9020\u7684\u201c\u9f0e\u201d\u53d6\u5f97\u4e86\u6210\u6548\u3002\u7b49\u7d0a\u6d41\u88ab\u8fdb\u4e00\u6b65\u51c0\u5316\uff0c\u592a\u9633\u518d\u6ca1\u6709\u906e\u6321\u7684\u65f6\u5019\uff0c\u5929\u8fd8\u4f1a\u66f4\u4eae\uff01<\/p>\n\n<p>\u7b2c\u4e8c\u4ef6\u559c\u4e8b\u561b\u2026\u2026\u5c31\u662f\u6211\u7ec8\u4e8e\u53c8\u80fd\u56de\u5de5\u574a\u6253\u94c1\u4e86\uff01\u809a\u5b50\u91cc\u8fd9\u5c0f\u7956\u5b97\u6298\u817e\u4e86\u6211\u597d\u51e0\u4e2a\u6708\uff0c\u603b\u7b97\u662f\u5e73\u5b89\u843d\u5730\uff01<\/p>\n\n<p>\u4f2f\u76