{"sfxsyt_8000":"1","ename":"159","cname":"\u6735\u8389\u4e9a","title":"\u4eba\u9c7c\u4e4b\u6b4c","pay_type":"","new_type":"1","hero_type":"6","hero_type2":"","hero_type3":"7","hero_type4":"8","survive_value":"4","attack_value":"2","skill_value":"8","difficulty_value":"2","skin_name":"\u4eba\u9c7c\u4e4b\u6b4c&0|\u91d1\u8272\u6f6e\u6c50&1|\u5fc3\u52a8\u624b\u8bb0&137","story":"<p>\u6df1\u6d77\u7684\u4eba\u9c7c\u4e00\u65cf\uff0c\u5343\u767e\u5e74\u6765\u7528\u6b4c\u58f0\u5b88\u62a4\u7740\u6d77\u6d0b\u7684\u5b81\u9759\uff0c\u62e5\u6709\u795e\u804c\u8005\u8840\u8109\u7684\u4eba\u9c7c\u5c11\u5973\u6735\u8389\u4e9a\u4fbf\u51fa\u8eab\u4e8e\u6d77\u5e95\uff0c\u70ed\u5ff1\u5f00\u6717\u7684\u5979\u6709\u7740\u5929\u7c41\u822c\u7684\u6b4c\u58f0\uff0c\u56e0\u6b64\u5f97\u5230\u5927\u796d\u53f8\u957f\u5916\u7956\u6bcd\u548c\u65cf\u4eba\u7684\u4e07\u5343\u5ba0\u7231\uff0c\u540c\u65f6\u4e5f\u88ab\u5bc4\u4e88\u539a\u671b\u3002\u70ed\u7231\u5531\u6b4c\u4e14\u5929\u8d4b\u8fc7\u4eba\u7684\u4eba\u9c7c\u5c0f\u516c\u4e3b\uff0c\u5728\u795d\u6b4c\u957f\u8001\u7684\u6559\u5bfc\u4e0b\u8981\u5b66\u4e60\u66f4\u591a\u66f4\u96be\u7684\u4eba\u9c7c\u795d\u6b4c\uff0c\u5f88\u5c11\u6709\u673a\u4f1a\u80fd\u4ea4\u5230\u771f\u6b63\u7684\u670b\u53cb\u3002<\/p>\n<p>\u5c0f\u65f6\u5019\uff0c\u5728\u4e00\u6b21\u5077\u6e9c\u524d\u5f80\u8ff7\u96fe\u4e4b\u6d77\u6c89\u8239\u5b9d\u85cf\u201c\u5bfb\u5b9d\u201d\u7684\u9014\u4e2d\uff0c\u6735\u8389\u4e9a\u7528\u6b4c\u58f0\u6551\u8d77\u4e86\u4e00\u4e2a\u906d\u9047\u6d77\u96be\u7684\u4eba\u7c7b\u5c0f\u7537\u5b69\u2014\u2014\u6d77\u90fd\u547d\u8fd0\u5bb6\u65cf\u5c11\u4e3b\u6d77\u8bfa\uff0c\u4ece\u6b64\uff0c\u5f00\u59cb\u62e5\u6709\u4e86\u7b2c\u4e00\u4e2a\u771f\u6b63\u610f\u4e49\u4e0a\u7684\u670b\u53cb\u3002\n\u5f80\u540e\u7684\u65e5\u5b50\u91cc\uff0c\u6735\u8389\u4e9a\u5e38\u5e38\u4f1a\u5077\u6e9c\u5230\u6d77\u90fd\u53bb\u627e\u5c0f\u6d77\u8bfa\u73a9\u800d\uff0c\u5bf9\u4e8e\u8fc7\u65e9\u5931\u53bb\u53cc\u4eb2\u627f\u53d7\u7740\u5bb6\u65cf\u547d\u8fd0\u5b64\u72ec\u7684\u6d77\u8bfa\uff0c\u548c\u9c9c\u6709\u4f19\u4f34\u5411\u5f80\u70ed\u5ff1\u53cb\u8c0a\u7684\u5c0f\u4eba\u9c7c\u6735\u8389\u4e9a\u6765\u8bf4\uff0c\u8fd9\u5bf9\u4e24\u5c0f\u65e0\u731c\u7684\u201c\u79d8\u5bc6\u4f19\u4f34\u201d\u5f7c\u6b64\u65e9\u5df2\u6210\u4e3a\u5bf9\u65b9\u6700\u91cd\u8981\u7684\u5b58\u5728\u3002<\/p>\n<br><p>\u6d77\u90fd\u4e00\u5e74\u4e00\u5ea6\u7684\u70df\u706b\u5927\u4f1a\u5373\u5c06\u4e3e\u884c\uff0c\u7136\u800c\uff0c\u4e0d\u660e\u7f18\u7531\u7684\u6c61\u67d3\u5374\u52a0\u901f\u4e86\u6d77\u5e95\u6df1\u6e0a\u5de8\u517d\u7684\u82cf\u9192\uff0c\u60c5\u6025\u4e4b\u4e2d\uff0c \u4e3a\u5e2e\u6735\u8389\u4e9a\u627e\u5230\u90a3\u9996\u4f20\u8bf4\u4e2d\u9971\u542b\u7740\u6700\u771f\u631a\u60c5\u611f\u8bb0\u5fc6\uff0c\u80fd\u5b89\u629a\u6d77\u517d\u7684\u201c\u4eba\u9c7c\u4e4b\u6b4c\u201d\uff0c\u6d77\u8bfa\u7528\u7aa5\u63a2\u547d\u8fd0\u7684\u80fd\u529b\uff0c\u5e26\u5979\u53bb\u5f80\u547d\u8fd0\u65f6\u7a7a\u91cc\u82e5\u5e72\u5e74\u540e\u7684\u672a\u6765\uff0c\u5728\u8001\u53bb\u7684\u6d77\u8bfa\u90a3\u91cc\uff0c\u627e\u5230\u7528\u4fe9\u4eba\u4e00\u751f\u56de\u5fc6\u8c31\u5199\u7684\u201c\u4eba\u9c7c\u4e4b\u6b4c\u201d\u3002\u5c3d\u7ba1\u4e0d\u613f\u63a5\u53d7\u547d\u8fd0\u7684\u7b54\u6848\uff0c\u6735\u8389\u4e9a\u6700\u7ec8\u8fd8\u662f\u9009\u62e9\u5531\u51fa\u8fd9\u9996\u201c\u4eba\u9c7c\u4e4b\u6b4c\u201d\uff0c\u8ba9\u72c2\u8e81\u7684\u5de8\u517d\u541e\u566c\u6389\u4fe9\u4eba\u6700\u7f8e\u597d\u7684\u60c5\u611f\u8bb0\u5fc6\u5f97\u5230\u5b89\u629a\uff0c\u4f46\u8fd9\u4e5f\u610f\u5473\u7740\u9009\u62e9\u4e86\u5f7c\u6b64\u7684\u9057\u5fd8\u548c\u5931\u53bb\u2026\u2026<\/p>\n<br><p>\u5386\u7ecf\u6d77\u517d\u5371\u673a\u7684\u6735\u8389\u4e9a\uff0c\u7ec8\u4e8e\u4ece\u591a\u65e5\u7684\u660f\u8ff7\u4e2d\u9192\u4e86\u8fc7\u6765\uff0c\u5374\u603b\u89c9\u5f97\u4eff\u4f5b\u5931\u53bb\u4e86\u4e00\u6bb5\u5f88\u91cd\u8981\u7684\u8bb0\u5fc6\uff0c\u53ef\u600e\u4e48\u4e5f\u60f3\u4e0d\u8d77\u6765\u3002\u76f4\u5230\u5c0f\u84dd\u9c7c\u4ece\u6d77\u5e95\u53fc\u56de\u4e00\u6761\u773c\u719f\u5374\u201c\u53e4\u602a\u201d\u7684\u6d77\u87ba\u624b\u94fe\uff0c\u4e3a\u4e86\u89e3\u5f00\u5fc3\u4e2d\u7684\u7591\u60d1\uff0c\u5979\u7792\u7740\u5927\u796d\u53f8\u957f\u5916\u7956\u6bcd\uff0c\u5728\u7d20\u6765\u5ba0\u7231\u5979\u7684\u5916\u7956\u7236\u63a9\u62a4\u4e0b\u8e0f\u4e0a\u4e86\u524d\u5f80\u6d77\u90fd\u5bfb\u627e\u771f\u76f8\u4e4b\u65c5\u3002<\/p>\n<br><p>\u4e0d\u8c19\u4e16\u4e8b\uff0c\u4f2a\u88c5\u6210\u4eba\u7c7b\u6765\u5230\u6d77\u90fd\u7684\u5979\uff0c\u52a0\u4e0a\u8131\u7ebf\u5927\u6761\u7684\u6027\u5b50\uff0c\u4e00\u8def\u4e0a\u95f9\u51fa\u5404\u79cd\u7b11\u8bdd\uff0c\u751a\u81f3\u6709\u60ca\u65e0\u9669\u7684\u906d\u9047\uff0c\u5e76\u8bef\u6253\u8bef\u649e\u78b0\u89c1\u4e86\u4eba\u4eec\u53e3\u4e2d\u795e\u901a\u5e7f\u5927\u7684\u547d\u8fd0\u4e4b\u5b50\uff0c\u81ea\u6765\u719f\u7684\u6735\u8389\u4e9a\u201c\u767e\u6298\u4e0d\u6320\u201d\u7f20\u6c42\u6d77\u8bfa\u7b54\u7591\u89e3\u60d1\uff0c\u5374\u603b\u662f\u88ab\u5979\u53e3\u4e2d\u7684\u201c\u51b0\u5757\u8138\u201d\u62d2\u7edd\u3002<\/p>\n<p>\u515c\u515c\u8f6c\u8f6c\u9887\u4e3a\u82e6\u607c\u4e4b\u9645\uff0c\u5728\u6d77\u90fd\u5e02\u96c6\u4e0d\u77e5\u6253\u54ea\u513f\u6765\u7684\u201c\u5973\u5deb\u201d\u6307\u5f15\u4e0b\uff0c\u6735\u8389\u4e9a\u9690\u7792\u4eba\u9c7c\u8eab\u4efd\uff0c\u5077\u5077\u85cf\u5728\u706b\u9e70\u53f7\u7684\u6728\u6876\u91cc\uff0c\u501f\u8239\u524d\u5f80\u73ca\u745a\u5c9b\u5bfb\u627e\u4f20\u8bf4\u4e2d\u80fd\u5e2e\u5fd9\u5524\u56de\u5931\u843d\u8bb0\u5fc6\u7684\u201c\u5b9d\u7269\u201d\u3002\u5c3d\u7ba1\u7834\u7efd\u767e\u51fa\uff0c\u88ab\u8239\u957f\u83b1\u897f\u5965\u3001\u5c0f\u6ee1\u3001\u72c2\u94c1\u4e00\u884c\u4eba\u6293\u4e2a\u73b0\u5f62\uff0c\u4f46\u70ed\u5ff1\u8131\u7ebf\u7684\u5979\u5f88\u5feb\u4fbf\u548c\u5927\u5bb6\u6253\u6210\u4e00\u7247\uff0c\u5e76\u5728\u8ff7\u96fe\u4e4b\u6d77\u518d\u6b21\u9047\u4e0a\u524d\u6765\u89e3\u51b3\u6c61\u67d3\u7684\u547d\u8fd0\u4e4b\u5b50\u6d77\u8bfa\uff0c\u5927\u5bb6\u6700\u7ec8\u6392\u9664\u4e07\u96be\u5408\u529b\u89e3\u51b3\u4e86\u6c61\u67d3\uff0c\u4e00\u8def\u4e58\u98ce\u7834\u6d6a\u7684\u5192\u9669\u4e4b\u540e\uff0c\u4e00\u7fa4\u4eba\u6210\u4e3a\u4e86\u5386\u7ecf\u751f\u6b7b\u7684\u4f19\u4f34\uff0c\u5171\u540c\u8fd4\u56de\u6d77\u90fd\u3002<\/p>\n<br><p>\u5c3d\u7ba1\u6735\u8389\u4e9a\u4e0e\u8fd9\u4e2a\u770b\u4e0a\u53bb\u603b\u6709\u4e9b\u9762\u719f\u7684\u201c\u51b0\u5757\u8138\u201d\u6d77\u8bfa\uff0c\u4ecd\u7136\u603b\u662f\u76f8\u4e92\u5acc\u5f03\uff0c\u4f46\u4e24\u4eba\u95f4\u6709\u4e9b\u7279\u522b\u7684\u4e1c\u897f\u4f3c\u4e4e\u5728\u6084\u6084\u840c\u751f\uff0c\u4e0d\u7ba1\u600e\u6837\uff0c\u65b0\u7684\u6545\u4e8b\u603b\u4f1a\u7ee7\u7eed\u2026\u2026<\/p>\n<br><br><br><p>\n<b><\/b><\/p><p><b><font color=\"#007ac0\">\u5b9d\u85cf<\/font><\/b><\/p><br><p>\u851a\u84dd\u8272\u6df1\u6d77\uff0c\u4eba\u9c7c\u65cf\u4e16\u4ee3\u6816\u5c45\u7684\u795d\u798f\u6c34\u57df\u4e2d\uff0c\u6591\u6593\u8367\u5149\u8426\u7ed5\u76d8\u65cb\uff0c\u661f\u661f\u70b9\u70b9\u5b9b\u82e5\u6d77\u5e95\u94f6\u6cb3\u4e00\u822c\u3002<\/p>\n<p>\u5723\u5bab\u7684\u949f\u58f0\uff0c\u4e0d\u591a\u4e0d\u5c11\u6572\u54cd\u4e86\u4e09\u4e0b\u3002<\/p>\n<p>\u795d\u6b4c\u5b66\u5bab\u6700\u4e0a\u65b9\u6ce2\u7eb9\u7a79\u9876\u7684\u5bab\u6bbf\u91cc\uff0c\u6bcf\u5230\u8fd9\u65f6\uff0c\u603b\u4f1a\u4f20\u6765\u5929\u7c41\u822c\u7684\u6b4c\u58f0\uff0c\u4eba\u9c7c\u5c0f\u516c\u4e3b\u6735\u8389\u4e9a\u6b63\u5728\u795d\u6b4c\u957f\u8001\u7684\u6089\u5fc3\u6559\u6388\u4e0b\uff0c\u201c\u8ba4\u771f\u201d\u5b66\u4e60\u7740\u201c\u6e4d\u6d41\u4e4b\u6b4c\u201d\u7b2c\u4e8c\u5341\u4e09\u7ae0\u7b2c\u5341\u4e03\u8282\u3002<\/p>\n<p>\u201c\u4e0d\u9519\uff01\u4eca\u65e5\u5b66\u5f97\u5f88\u5feb\uff0c\u53d1\u97f3\u4e5f\u5f88\u51c6\u786e\uff0c\u5f88\u597d\uff01\u201d\u4e00\u5411\u4ee5\u4e25\u82db\u8457\u79f0\u7684\u795d\u6b4c\u957f\u8001\u722c\u6ee1\u91d1\u8272\u957f\u987b\u7684\u8138\u4e0a\u9732\u51fa\u6ee1\u610f\u7684\u795e\u8272\u3002<\/p>\n<p>\u5bf9\u8fd9\u4e2a\u5929\u8d4b\u8fc7\u4eba\u7684\u5b69\u5b50\uff0c\u4ed6\u5411\u6765\u8d5e\u4e0d\u7edd\u53e3\uff0c\u4ee5\u81f3\u4e8e\u5b8c\u5168\u5ffd\u7565\u4e86\u6735\u8389\u4e9a\u4e00\u8fb9\u201c\u4e13\u5fc3\u201d\u5531\u6b4c\uff0c\u4e00\u8fb9\u4e0d\u8001\u5b9e\u5730\u5728\u73ca\u745a\u77f3\u5c0f\u684c\u4e0b\uff0c\u7528\u5c0f\u624b\u5012\u817e\u7740\u81ea\u5df1\u4ece\u8ff7\u96fe\u4e4b\u6d77\u7684\u6c89\u8239\u91cc\u6dd8\u6765\u7684\u201c\u5b9d\u85cf\u201d\u2014\u2014\u51e0\u679a\u4eba\u7c7b\u4e16\u754c\u5927\u5927\u5c0f\u5c0f\u7684\u786c\u5e01\u548c\u4e00\u53ea\u8896\u73cd\u70df\u6597\uff0c\u5076\u5c14\u53d1\u51fa\u53ee\u5464\u54d0\u5577\u7684\u58f0\u54cd\uff0c\u4e5f\u88ab\u5979\u5b8c\u7f8e\u63a9\u76d6\u5728\u5639\u4eae\u4f18\u7f8e\u7684\u6b4c\u58f0\u91cc\u3002<\/p>\n<p>\u8d81\u957f\u8001\u4e0d\u6ce8\u610f\uff0c\u5979\u8fd8\u65f6\u4e0d\u65f6\u671b\u5411\u7a97\u5916\uff0c\u5077\u7784\u51e0\u773c\u795d\u6b4c\u5e7f\u573a\u91cc\u901a\u5b66\u7684\u5c0f\u4eba\u9c7c\u4eec\uff0c\u56e0\u4e3a\u81ea\u5df1\u603b\u8981\u5b66\u4e60\u66f4\u591a\u66f4\u96be\u7684\u795d\u6b4c\uff0c\u8fdb\u5ea6\u4e5f\u6bd4\u522b\u4eba\u5feb\u4e86\u8bb8\u591a\uff0c\u6735\u8389\u4e9a\u603b\u6ca1\u6709\u529e\u6cd5\u5728\u5b66\u5bab\u5e7f\u573a\u4e0a\u8ddf\u4ed6\u4eec\u4e00\u5757\u513f\u5b66\u4e60\u3002<\/p>\n<p>\u770b\u4e0a\u53bb\uff0c\u5e7f\u573a\u4e0a\u4e00\u5927\u7fa4\u5c0f\u4eba\u9c7c\u7b11\u7b11\u95f9\u95f9\uff0c\u6e38\u6765\u6e38\u53bb\u4e00\u8d77\u5408\u5531\u7684\u6837\u513f\u53ef\u771f\u4ee4\u4eba\u7fa1\u6155\u5440\u3002<\/p>\n<p>\u8c01\u4f1a\u6599\u5230\uff0c\u53d7\u5230\u4eba\u9c7c\u65cf\u5927\u796d\u53f8\u957f\u5916\u7956\u6bcd\u4e07\u5343\u5ba0\u7231\uff0c\u88ab\u795d\u6b4c\u957f\u8001\u6210\u65e5\u5938\u8d5e\uff0c\u65cf\u4eba\u4eec\u5bc4\u4e88\u539a\u671b\uff0c\u6240\u6709\u4eba\u5fc3\u76ee\u4e2d\u672a\u6765\u6d77\u796d\u53f8\u7ee7\u627f\u4eba\u7684\u6735\u8389\u4e9a\u4e5f\u6709\u5c5e\u4e8e\u81ea\u5df1\u7684\u5c0f\u5c0f\u70e6\u607c\uff0c\u52a0\u4e0a\u65cf\u4eba\u4eec\u8fc7\u5206\u7684\u5c0a\u5d07\uff0c\u5979\u751a\u81f3\u90fd\u6ca1\u6709\u4e00\u4e2a\u6210\u65e5\u73a9\u5728\u4e00\u5757\u513f\u771f\u6b63\u7684\u5c0f\u4f19\u4f34\uff0c\u9664\u4e86\u8eab\u8fb9\u7684\u4e24\u6761\u5c0f\u9c7c\u3002<\/p>       \n<p>\u5723\u5bab\u7684\u949f\u58f0\u518d\u5ea6\u54cd\u8d77\uff0c\u201c\u4eca\u65e5\uff0c\u6211\u4eec\u5c31\u5b66\u5230\u8fd9\u91cc\u5427\uff0c\u6735\u8389\u4e9a\u516c\u4e3b\uff01\u660e\u65e5\u51c6\u5907\u8ddf\u4f60\u8bb2\u89e3'\u5947\u8ff9\u4e4b\u6b4c\u2018\u7684\u6545\u4e8b\u2026\u2026\u201d<\/p>\n<p>\u201c\u4e07\u5c81\uff01\u8c22\u8c22\u795d\u6b4c\u957f\u8001\uff0c\u4f60\u662f\u5168\u6d77\u6d0b\u6700\u597d\u6700\u597d\u7684\u8001\u5e08\u2026\u2026\u201d\u542c\u5230\u4e0b\u8bfe\u6307\u793a\uff0c\u957f\u8001\u8bdd\u97f3\u8fd8\u672a\u843d\uff0c\u6735\u8389\u4e9a\u4fbf\u683c\u5916\u5174\u594b\u5f97\u8df3\u4e86\u8d77\u6765\u5f00\u59cb\u97a0\u8eac\uff0c\u5dee\u70b9\u4e0d\u5c0f\u5fc3\u6296\u843d\u4e86\u684c\u4e0b\u7684\u90a3\u4e9b\u5c0f\u73a9\u610f\u513f\u2026\u2026<\/p>\n<p>\u4e4b\u6240\u4ee5\u6bd4\u5f80\u5e38\u66f4\u52a0\u5174\u594b\uff0c\u5b8c\u5168\u56e0\u4e3a\u4eca\u5929\u662f\u5c5e\u4e8e\u6735\u8389\u4e9a\u81ea\u5b9a\u4e49\u7684\u201c\u5b9d\u85cf\u65e5\u201d\uff0c\u8fd9\u53ea\u5c0f\u4eba\u9c7c\u53c8\u8981\u51c6\u5907\u5077\u6e9c\u524d\u5f80\u8ff7\u96fe\u4e4b\u6d77\u7684\u73ca\u745a\u7901\u201c\u5bfb\u5b9d\u201d\u4e86\uff0c\u5728\u90a3\u91cc\u5979\u603b\u80fd\u627e\u5230\u4e00\u4e9b\u4eba\u7c7b\u6c89\u8239\u7559\u4e0b\u7684\u201c\u65b0\u5947\u73a9\u610f\u201d\u3002<\/p>\n<p>\u4e00\u5411\u6eba\u7231\u5979\u7684\u5916\u7956\u7236\u8d6b\u5c14\u5f25 \uff0c\u65e9\u5df2\u5e2e\u5979\u5728\u5723\u5bab\u7684\u4fa7\u95e8\u652f\u5f00\u4e86\u5b88\u536b\uff0c\u505a\u597d\u4e86\u4e00\u5207\u201c\u63a9\u62a4\u201d\u5de5\u4f5c\uff0c\u96be\u602a\u4eca\u5929\u6735\u8389\u4e9a\u7ec3\u5f97\u6781\u5feb\uff0c\u6068\u4e0d\u5f97\u65e9\u65e9\u4e0b\u5b66\u3002 <\/p>\n<br><p>\u201c\u8d6b\u5c14\u5f25\u5916\u516c\uff0c\u6211\u6765\u5566\uff01\uff01\uff01\u201d\u4f34\u968f\u7740\u6b22\u5feb\u7684\u7b11\u58f0\uff0c\u4e00\u4e2a\u5c0f\u5c0f\u7684\u8eab\u5f71\u7a7f\u8fc7\u6d77\u5e95\u82b1\u56ed\uff0c\u4ece\u5bab\u95e8\u8001\u8fdc\u7684\u5730\u65b9\u50cf\u68ad\u5b50\u822c\u6e38\u4e86\u8fc7\u6765\u3002<\/p>\n<p>\u201c\u5618\uff01\uff01\uff01\u4f60\u53ef\u5c0f\u58f0\u70b9\uff0c\u62db\u6765\u4e86\u5b88\u536b\uff0c\u8fd8\u6709\u4f60\u90a3\u5a01\u4e25\u7684\u5916\u7956\u6bcd\uff0c\u6211\u53ef\u4e0d\u8d1f\u8d23\u5e2e\u4f60\u5584\u540e\u201d\u5916\u7956\u7236\u8d6b\u5c14\u5f25\u4e00\u8fb9\u4f6f\u88c5\u4e25\u8083\u5730\u5631\u6258\u7740\uff0c\u4e00\u8fb9\u4e3a\u603b\u662f\u5927\u6761\u7684\u6735\u8389\u4e9a\u634f\u628a\u6c57\u3002<\/p>\n<p>\u201c\u653e\u5fc3\u5427\uff0c\u5916\u516c\uff01\u6211\u53ef\u662f\u7531\u5e78\u8fd0\u6d77\u795e\u5e87\u4f51\u7684\u4eba\u9c7c\u5c0f\u5c0f\u6d77\u796d\u53f8\u6735\u8389\u4e9a\uff0c\u4e0d\u4f1a\u9732\u9985\u7684!\u201d<\/p>\n<p>\u201c\u597d\u597d\u597d\uff0c\u662f\u662f\u662f\uff0c\u6ce8\u610f\u5b89\u5168\uff0c\u65e9\u70b9\u56de\u6765\u3002\u201d\u8d6b\u5c14\u5f25\u957f\u6ee1\u767d\u80e1\u5b50\u7684\u8138\u4e0a\u9732\u51fa\u6148\u7965\u7684\u7b11\u5bb9\u3002\u5bf9\u4e8e\u5c0f\u5c0f\u5e74\u7eaa\u5c31\u638c\u63e1\u4e86\u8bb8\u591a\u795d\u6b4c\u80fd\u529b\u7684\u5916\u5b59\u5973\uff0c\u53bb\u8d9f\u795d\u798f\u6c34\u57df\u9644\u8fd1\u7684\u8ff7\u96fe\u4e4b\u6d77\u4e5f\u4e0d\u7b97\u4ec0\u4e48\u5371\u9669\u7684\u4e8b\uff0c\u5c31\u7531\u7740\u5979\u5427\u3002<\/p>\n<p>\u201c\u653e\u5fc3\u5427\uff0c\u6211\u7684\u597d\u5916\u516c\uff01\u6735\u8389\u4e9a\u4e00\u5b9a\u901f\u53bb\u901f\u56de\uff0c\u8bb0\u5f97\u7ed9\u6211\u7559\u95e8\u54df\uff01\u201d\u500f\u7684\uff0c\u5c0f\u8eab\u5f71\u7684\u6d41\u5149\u4fbf\u6d88\u5931\u5728\u851a\u84dd\u6591\u9a73\u7684\u8367\u5149\u4e4b\u4e2d\uff0c\u5f80\u8ff7\u96fe\u4e4b\u6d77\u7684\u65b9\u5411\u8fdc\u53bb\u3002<\/p>\n<br><p>\u8ff7\u96fe\u4e4b\u6d77\u4e0a\uff0c\u904d\u5e03\u7740\u65b9\u5706\u5341\u6570\u6d77\u91cc\u96f6\u96f6\u843d\u843d\u7684\u73ca\u745a\u7901\u7fa4\uff0c\u5982\u540c\u8ff7\u5bab\u4e00\u822c\uff0c\u6709\u65f6\uff0c\u6d77\u8367\u77f3\u7c89\u5c18\u5f62\u6210\u7684\u5e7b\u68a6\u8ff7\u96fe\u5f25\u6f2b\u5f00\u6765\uff0c\u66f4\u662f\u8ba9\u4eba\u627e\u4e0d\u7740\u5317\u3002\u6570\u767e\u5e74\u6765\uff0c\u65e0\u6570\u4eba\u7c7b\u8239\u53ea\u5728\u8fd9\u91cc\u89e6\u7901\u6c89\u8239\uff0c\u6b8b\u9ab8\u6ca1\u5165\u6d77\u9762\u4e0b\u5de8\u5927\u7684\u73ca\u745a\u77f3\u4e2d\u5f62\u6210\u5e74\u4ee3\u4e45\u8fdc\u7684\u9057\u8ff9\uff0c\u5b83\u4eec\u4e5f\u6210\u4e3a\u4e86\u5c0f\u4eba\u9c7c\u6735\u8389\u4e9a\u79d8\u5bc6\u7684\u201c\u5bfb\u5b9d\u201d\u4e50\u56ed\u3002<\/p>\n<p>\u4eca\u65e5\u7684\u6d77\u9762\u4e0a\uff0c\u900f\u7740\u68a6\u5e7b\u822c\u8be1\u8c32\u8272\u5f69\u7684\u8ff7\u96fe\u4f3c\u4e4e\u683c\u5916\u6d53\u91cd\uff0c\u4e45\u4e45\u8426\u7ed5\u4e0d\u6563\uff0c\u4f34\u968f\u7740\u7a81\u5165\u5176\u6765\u7684\u4e00\u573a\u5de8\u5927\u98ce\u66b4\uff0c\u4e00\u8258\u6845\u6746\u4e0a\u60ac\u7740\u65f6\u949f\u56fe\u6848\u7684\u822a\u8239\u88ab\u6f29\u6da1\u5377\u5165\u4e86\u8fd9\u7247\u5371\u9669\u7684\u6d77\u57df\uff0c\u5c31\u5728\u9877\u523b\u4e4b\u95f4\uff0c\u968f\u7740\u5de8\u6d6a\u72c2\u98ce\u7684\u6495\u626f\uff0c\u822a\u8239\u4fbf\u9010\u6e10\u5728\u7901\u77f3\u7684\u731b\u70c8\u649e\u51fb\u4e0b\u6563\u4e86\u67b6\u2026\u2026<\/p>\n<p>\u6d77\u9762\u4e0a\u60ca\u6d9b\u9a87\u6d6a\uff0c\u5e7b\u96fe\u91cd\u91cd\uff0c\u6d77\u9762\u4e0b\uff0c\u6563\u5e03\u7740\u73ca\u745a\u7901\u77f3\u548c\u6c89\u8239\u9057\u8ff9\u7684\u4e16\u754c\u4ecd\u65e7\u5e73\u9759\uff0c\u7136\u800c\uff0c\u5929\u751f\u5bf9\u6d0b\u6d41\u654f\u9510\u7684\u5c0f\u4eba\u9c7c\u8fd8\u662f\u611f\u53d7\u5230\u4e86\u4e00\u4e1d\u5f02\u6837\uff0c\u56de\u9996\u95f4\uff0c\u8fdc\u5904\u4e00\u4e2a\u7f13\u7f13\u4e0b\u5760\u7684\u5c0f\u8eab\u5f71\u5438\u5f15\u4e86\u6735\u8389\u4e9a\u7684\u76ee\u5149\u3002<\/p>\n<p>\u90a3\u662f\uff1f\u90a3\u662f\u4e00\u4e2a\u4eba\u7c7b\u7684\u5c0f\u7537\u5b69\uff01<\/p>\n<p>\u60c5\u6025\u4e4b\u4e2d\uff0c\u6735\u8389\u4e9a\u98de\u5feb\u6e38\u8fc7\u53bb\uff0c\u6025\u901f\u8ff8\u53d1\u7684\u80fd\u91cf\uff0c\u4f7f\u5f97\u5c3e\u9ccd\u5728\u6d77\u6c34\u4e2d\u5212\u51fa\u4e00\u9053\u9053\u70ab\u76ee\u7684\u6d41\u5149\u2026\u2026\u5979\u7528\u81ea\u5df1\u5c0f\u5c0f\u7684\u8eab\u8eaf\uff0c\u62fd\u7740\u53e6\u4e00\u4e2a\u5c0f\u5c0f\u7684\u8eab\u8eaf\uff0c\u52aa\u529b\u5f80\u6d77\u9762\u4e0a\u98ce\u5e73\u6d6a\u9759\u5904\u6e38\u53bb\u3002<\/p>\n<p>\u597d\u4e0d\u5bb9\u6613\u624d\u627e\u5230\u4e00\u5757\u6f02\u6d6e\u7684\u6b8b\u7834\u6728\u677f\uff0c\u8d39\u52b2\u5c06\u6eba\u6c34\u7684\u5c0f\u7537\u5b69\u201c\u6254\u201d\u4e86\u4e0a\u53bb\u2026\u2026<\/p>\n<p>\u6d77\u5e73\u9762\u4e0a\u7684\u5929\u7a7a\uff0c\u4ece\u843d\u65e5\u7684\u4f59\u6656\uff0c\u76f4\u5230\u6f2b\u5929\u661f\u661f\u5728\u5934\u9876\u4e0a\u95ea\u70c1\uff0c\u5f53\u6735\u8389\u4e9a\u628a\u201c\u6cbb\u6108\u4e4b\u6b4c\u201d\u5531\u5230\u7b2c\u4e94\u5341\u4e8c\u904d\u65f6\uff0c\u6728\u677f\u4e0a\u7684\u4eba\u7c7b\u5c0f\u7537\u5b69\u624d\u7ec8\u4e8e\u7f13\u7f13\u7741\u5f00\u4e86\u53cc\u773c\u2026\u2026<\/p>\n<p>\u201c\u4f60\u53eb\u4ec0\u4e48\u540d\u5b57\u5440\uff1f\u201d\u6735\u8389\u4e9a\u6491\u7740\u8111\u888b\uff0c\u7528\u5927\u773c\u775b\u597d\u5947\u5730\u6ce8\u89c6\u7740\u4ed6\u3002<\/p>\n<p>\u201c\u6211\u2026\u6211\u53eb\u6d77\u8bfa\u3002\u201d\u5c0f\u7537\u5b69\u602f\u751f\u751f\u7b54\u9053\uff0c\u614c\u4e71\u773c\u795e\u91cc\u8fd8\u900f\u7740\u4e0d\u4e45\u524d\u906d\u9047\u6d77\u96be\u7684\u60ca\u9b42\u672a\u5b9a\u3002<\/p>\n<p>\u201c\u6211\u53eb\u6735\u8389\u4e9a\uff0c\u4f60\u53ef\u4ee5\u53eb\u6211\u6735\u6735\uff01\u201d<\/p>\n<p>\u201c\u2026\u2026\u201d<\/p>\n<p>\u201c\u5077\u5077\u544a\u8bc9\u4f60\u4e00\u4e2a\u79d8\u5bc6\uff0c\u6211\u4eec\u53ef\u662f\u7ee7\u627f\u4e86\u4e0a\u53e4\u795e\u804c\u8005\u529b\u91cf\u53e4\u8001\u800c\u795e\u79d8\u7684\u4eba\u9c7c\u65cf\u54df\uff01\u201d<\/p>\n<p>\u201c\u5bf9\u4e86\uff0c\u5dee\u70b9\u5fd8\u4e86\uff0c\u4f60\u5f97\u5148\u7b54\u5e94\u6211\uff0c\u8981\u66ff\u6211\u4fdd\u5b88\u79d8\u5bc6\u5594\uff01\u201d<\/p>\n<p>\u201c\u2026\u2026\u201d<\/p>\n<p>\u201c\u4f60\u5c31\u662f\u4eba\u7c7b\u5427\uff1f\u4f60\u957f\u5f97\u597d\u5947\u602a\u554a\uff0c\u5728\u6c34\u91cc\u90fd\u6ca1\u6709\u5c3e\u5df4\u8036\uff01\u201d<\/p>\n<p>\u201c\u6211\u4eec\u4eba\u9c7c\u65cf\u62e5\u6709\u53d8\u6362\u9c7c\u5c3e\u548c\u53cc\u817f\u7684\u80fd\u529b\uff0c\u5916\u7956\u6bcd\u8bf4\uff0c\u4e00\u65e6\u79bb\u5f00\u6c34\u6211\u4eec\u5c31\u53ef\u4ee5\u53d8\u51fa\u817f\uff0c\u5728\u6c34\u91cc\u53c8\u4f1a\u53d8\u56de\u5c3e\u5df4\uff0c\u5389\u5bb3\u5427\uff01\u201d<\/p>\n<p>\u201c\u2026\u2026\u201d<\/p>\n<p>\u201c\u795d\u6b4c\u957f\u8001\u8bf4\uff0c\u6211\u4eec\u662f\u56e0\u4e3a\u4e0a\u53e4\u8bf8\u795e\u6253\u67b6\uff0c\u624d\u642c\u5bb6\u5230\u6df1\u6d77\u4e16\u4ee3\u9690\u5c45\u8d77\u6765\u7684\uff0c\u7b97\u8d77\u6765\uff0c\u6211\u4eec\u7684\u7956\u5148\u7684\u7956\u5148\u7684\u7956\u5148\u53ef\u80fd\u8fd8\u662f\u4eb2\u621a\u5537\uff01\u201d<\/p>\n<p>\u201c\u2026\u2026\u201d<\/p>\n<p>\u201c\u5bf9\u4e86\uff0c\u6211\u4f1a\u5531\u7684\u4eba\u9c7c\u795d\u6b4c\u53ef\u591a\u5566\uff0c\u603b\u6709\u4e00\u9996\u80fd\u5e2e\u4e0a\u4f60\u7684\u5fd9\uff01\u4ee5\u540e\u8981\u662f\u518d\u9047\u5230\u9ebb\u70e6\u5c31\u5927\u558a\u2018\u6735\u6735\u2019\u7684\u540d\u5b57\u5427\uff01\u201d<\/p>\n<p>\u201c\u5bf9\u4e86\uff0c\u5927\u5bb6\u90fd\u8bf4\u6211\u5531\u6b4c\u53ef\u52a8\u542c\u4e86\uff0c\u4f60\u521a\u7761\u7740\u4e86\u90fd\u6ca1\u542c\u89c1\uff01\u201d<\/p>\n<p>\u201c\u6211\u5531\u9996\u7ed9\u4f60\u542c\u5427\uff0c\u5566\u5566\u5566\u5566\u2026\u2026\u5566\u5566\u5566\u5566\u2026\u2026\u201d<\/p>\n<p>\u201c\u2026\u2026\u201d<\/p>\n<p>\u201c\u54ce\u5440\uff0c\u4eca\u5929\u662f\u4f60\u6253\u4e71\u4e86\u6211\u7684\u2018\u5bfb\u5b9d\u2019\u8ba1\u5212\uff0c\u597d\u4e0d\u5bb9\u6613\u6e9c\u51fa\u6765\uff0c\u6211\u53ef\u4e0d\u80fd\u4e24\u624b\u7a7a\u7a7a\u767d\u8dd1\u4e00\u8d9f\uff01\u201d<\/p>\n<p>\u201c\u6709\u4e86\uff01\u4e0d\u5982\u628a\u4f60\u4e5f\u7b97\u4f5c\u2018\u5b9d\u85cf\u2019\u5427\uff01\u56de\u5934\u7edf\u7edf\u8ba1\u5165\u6211\u7684\u5c0f\u672c\u672c\u91cc\u3002\u201d<\/p>\n<p>\u201c\u8fd9\u4e2a\u4e3b\u610f\u600e\u4e48\u6837\uff1f\u201d\u4e00\u76f4\u8bf4\u4e2a\u6ca1\u5b8c\u7684\u6735\u8389\u4e9a\u7a81\u7136\u5b89\u9759\u4e0b\u6765\uff0c\u6258\u7740\u5934\u7728\u5df4\u7740\u5927\u773c\u775b\uff0c\u671f\u5f85\u53c8\u5f00\u5fc3\u5730\u671b\u5411\u5c0f\u7537\u5b69\u3002<\/p>\n<p>\u2026\u2026<\/p>\n<p>\u201c\u55ef\u2026\u2026\u597d\u3002\u201d\u9694\u4e86\u8bb8\u4e45\uff0c\u4e00\u76f4\u63d2\u4e0d\u4e0a\u8bdd\u7684\u4eba\u7c7b\u5c0f\u7537\u5b69\uff0c\u7ec8\u4e8e\u6324\u51fa\u817c\u8146\u7684\u7b11\u5bb9\u3002<\/p>\n<br><br><br><p>\n<b><\/b><\/p><p><b><font color=\"#007ac0\">\u8fd9\u4e2a\u5bb6\u4f19<\/font><\/b><\/p><br><p>\u6d77\u90fd\u7684\u96e8\u679c\u7136\u6765\u5f97\u5feb\uff0c\u53bb\u5f97\u4e5f\u5feb\u3002<\/p>\n<p>\u53c8\u662f\u4e00\u573a\u9635\u96e8\uff0c\u90fd\u6765\u5230\u6d77\u90fd\u597d\u4e9b\u5929\u4e86\uff0c\u6735\u8389\u4e9a\u8fd8\u662f\u5f04\u4e0d\u660e\u767d\uff0c\u4e3a\u4ec0\u4e48\u4eba\u7c7b\u4e16\u754c\u7684\u6c34\u7adf\u7136\u4f1a\u4ece\u5929\u4e0a\u6389\u4e0b\u6765\uff01<\/p>\n<p>\u540c\u6837\u5f04\u4e0d\u660e\u767d\u7684\uff0c\u8fd8\u6709\u597d\u591a\u2014\u2014\u8b6c\u5982\uff0c\u4e3a\u4ec0\u4e48\u4e00\u4e0d\u7559\u795e\u603b\u662f\u4f1a\u88ab\u55b5\u55b5\u53eb\u7684\u56db\u89d2\u5c0f\u602a\u517d\u8ffd\u8d76\uff1f<\/p>\n<p>\u4e3a\u4ec0\u4e48\u4eba\u7c7b\u975e\u5f97\u7a7f\u978b\u4e0d\u53ef\uff1f<\/p>\n<p>\u4e3a\u4ec0\u4e48\u5728\u8ff7\u96fe\u4e4b\u6d77\u8ff7\u5bab\u4e00\u822c\u7684\u73ca\u745a\u7901\u91cc\u90fd\u80fd\u6765\u53bb\u81ea\u5982\uff0c\u4e00\u770b\u5230\u6d77\u90fd\u8fd9\u4e9b\u56db\u901a\u516b\u8fbe\u7684\u9a6c\u8def\uff0c\u5c31\u6839\u672c\u4e0d\u77e5\u9053\u8be5\u8d70\u54ea\u4e2a\u65b9\u5411\u2026\u2026<\/p>\n<p>\u5f53\u7136\uff0c\u6bd4\u8d77\u8fd9\u4e9b\u767e\u601d\u4e0d\u5f97\u5176\u89e3\u7684\u96be\u9898\uff0c\u6700\u4ee4\u5979\u82e6\u607c\u7684\uff0c\u8fd8\u662f\u8fd9\u8d9f\u4ece\u6d77\u5e95\u5077\u6e9c\u51fa\u6765\u6240\u8c13\u7684\u201c\u771f\u76f8\u4e4b\u65c5\u201d\uff0c\u5374\u8fd8\u6ca1\u6709\u627e\u5230\u90a3\u6bb5\u4f3c\u4e4e\u5f88\u91cd\u8981\u7684\u5931\u843d\u8bb0\u5fc6\u3002<\/p>\n<p>\u60f3\u5230\u8fd9\u91cc\uff0c\u6735\u8389\u4e9a\u53c8\u770b\u4e86\u4e00\u773c\u624b\u8155\u4e0a\u90a3\u6761\u773c\u719f\u5374\u201c\u53e4\u602a\u201d\u7684\u624b\u94fe\uff0c\u4e0a\u9762\u7684\u6d77\u87ba\u5728\u4e4c\u4e91\u540e\u7684\u9633\u5149\u4e0b\u95ea\u70c1\u7740\u4e94\u5f69\u6591\u6593\u7684\u5149\u8292\uff0c\u6f02\u4eae\u6781\u4e86\u3002<\/p>\n<p>\u7136\u800c\uff0c\u773c\u4e0b\u8fd8\u6709\u53e6\u4e00\u4ef6\u8ba9\u5979\u540c\u6837\u72af\u6101\u7684\u4e8b\u60c5\uff0c\u5c31\u662f\u624b\u91cc\u8fd9\u628a\u96e8\u4f1e\uff0c\u5df2\u7ecf\u62ce\u7740\u4e24\u5929\u4e86\uff0c\u201c\u5230\u5e95\u8981\u600e\u4e48\u8fd8\u7ed9\u90a3\u4e2a\u5bb6\u4f19\u5462\uff1f\u201d\u4e00\u8def\u4e0a\u6735\u8389\u4e9a\u4e00\u8fb9\u5c0f\u5fc3\u7ffc\u7ffc\u6296\u843d\u96e8\u4f1e\u4e0a\u7684\u6c34\u73e0\uff0c\u4e00\u8fb9\u5c0f\u58f0\u91cd\u590d\u561f\u56d4\u7740\u3002<\/p>\n<p>\u201c\u6709\u529e\u6cd5\u4e86\uff01\u201d\u770b\u7740\u8def\u65c1\u753b\u5eca\u91cc\u6b63\u5728\u5fd9\u6d3b\u7684\u4f19\u8ba1\uff0c\u6735\u8389\u4e9a\u7a81\u7136\u6765\u4e86\u7075\u611f\uff01 <\/p>\n<p>\u4e0d\u591a\u4e00\u4f1a\u513f\uff0c\u5979\u5c31\u7528\u4e00\u9897\u73cd\u73e0\u4ece\u753b\u5eca\u91cc\u6362\u4e86\u4e00\u6346\u753b\u7b14\u548c\u4e00\u5377\u753b\u5e03\uff0c\u5f00\u59cb\u4e86\u201c\u4eba\u751f\u201d\u7684\u7b2c\u4e00\u6b21\u521b\u4f5c\u2014\u2014\u6839\u636e\u8111\u6d77\u91cc\u201c\u90a3\u4e2a\u5bb6\u4f19\u201d\u7684\u6837\u5b50\uff0c\u6a21\u4eff\u4eba\u7c7b\u5b8c\u6210\u4e86\u4e00\u5e45\u81ea\u5df1\u751a\u662f\u6ee1\u610f\u7684\u201c\u8096\u50cf\u753b\u201d\u3002<\/p>\n<p>\u201c\u662f\u4e0d\u662f\u5f88\u6709\u5929\u8d4b\uff1f\u201d\u6735\u8389\u4e9a\u5f97\u610f\u6d0b\u6d0b\u5c55\u793a\u7740\u201c\u65b0\u51fa\u7089\u201d\u7684\u201c\u4f5c\u54c1\u201d\u8be2\u95ee\u8eab\u65c1\u7684\u4f19\u8ba1\uff0c\u6c89\u8ff7\u4e8e\u624b\u91cc\u95ea\u95ea\u53d1\u4eae\u7684\u73cd\u73e0\uff0c\u4f19\u8ba1\u5934\u4e5f\u6ca1\u62ac\uff0c\u8fde\u8fde\u53d1\u51fa\u8d5e\u53f9\u7684\u58f0\u97f3\u3002<\/p>\n<p>\u8fd9\u5bf9\u6735\u8389\u4e9a\u6765\u8bf4\u53ef\u662f\u83ab\u5927\u7684\u9f13\u52b1\uff0c\u63a5\u4e0b\u6765\uff0c\u84dd\u8272\u5934\u53d1\u7684\u5c11\u5973\uff0c\u5728\u9633\u5149\u4e0b\uff0c\u62ce\u7740\u4e00\u628a\u96e8\u4f1e\uff0c\u62ff\u7740\u4e00\u5e45\u201c\u8096\u50cf\u753b\u201d\u5174\u594b\u5730\u98de\u5954\u5f80\u6d77\u90fd\u7684\u5e02\u96c6\u3002<\/p>\n<p>\u5f53\u5403\u4e86\u4e09\u4e2a\u51b0\u6dc7\u6dcb\uff0c\u4e00\u5757\u5c0f\u86cb\u7cd5\uff0c\u4e24\u4efd\u679c\u9171\u997c\uff0c\u4e03\u9897\u725b\u5976\u7cd6\u4e4b\u540e\uff0c\u60bb\u60bb\u7684\u6735\u8389\u4e9a\u6254\u6389\u624b\u91cc\u4ee4\u4eba\u201c\u77a0\u76ee\u7ed3\u820c\u201d\u7684\u4f5c\u54c1\uff0c\u6f2b\u6b65\u5230\u6d77\u90fd\u6b63\u5348\u65f6\u5206\u7684\u5f17\u4f26\u6b4c\u5267\u9662\uff0c\u5267\u9662\u7684\u7a79\u9876\u5728\u9633\u5149\u4e0b\uff0c\u5b9b\u5982\u4e00\u679a\u7480\u74a8\u7684\u5b9d\u77f3\u3002<\/p>\n<p>\u5f53\u542c\u5230\u5267\u9662\u91cc\u7ec3\u4e60\u7684\u6b4c\u8005\uff0c\u65ad\u65ad\u7eed\u7eed\u4f20\u6765\u7684\u60a0\u626c\u6b4c\u58f0\uff0c\u65b9\u624d\u8fd8\u6ca1\u7cbe\u6253\u91c7\u7684\u6735\u8389\u4e9a\u53c8\u77ac\u95f4\u5174\u594b\u4e86\u8d77\u6765\uff01<\/p>\n<p>\u5ffd\u7136\uff0c\u4e00\u8f86\u534e\u4e3d\u7684\u9a6c\u8f66\u4ece\u5267\u9662\u7684\u5927\u9053\u4e2d\u9a76\u4e86\u51fa\u6765\uff0c\u7b49\u7b49\uff01\u6735\u8389\u4e9a\u64e6\u4e86\u64e6\u773c\u775b\uff0c\u9a6c\u8f66\u4e0a\u7684\u4eba\u600e\u4e48\u8fd9\u4e48\u9762\u719f\uff01\u201c\u662f\u90a3\u4e2a\u5bb6\u4f19\uff01\u201d\u6735\u8389\u4e9a\u60ca\u547c\u95f4\uff0c\u9a6c\u8f66\u4ece\u5979\u773c\u524d\u98de\u9a70\u800c\u8fc7\u3002<\/p>\n<p>\u201c\u90a3\u2026\u2026\u90a3\u4e2a\u4eba\u662f\u8c01\uff1f\u201d\u6735\u8389\u4e9a\u7528\u624b\u91cc\u7684\u96e8\u4f1e\u6307\u7740\u8fdc\u53bb\u7684\u9a6c\u8f66\uff0c\u6025\u5fd9\u8be2\u95ee\u5267\u9662\u7684\u95e8\u7ae5\u3002<\/p>\n<p>\u201c\u4ed6\u4f60\u90fd\u4e0d\u8ba4\u8bc6\uff0c\u8fd9\u53ef\u662f\u6d77\u90fd\u963f\u5c14\u5361\u7eb3\u5bb6\u65cf\u4e4b\u4e00\u547d\u8fd0\u5bb6\u65cf\u7684\u5c11\u4e3b\u2014\u2014\u547d\u8fd0\u4e4b\u5b50\u6d77\u8bfa\u3002\u201d\u95e8\u7ae5\u4e00\u5e45\u5acc\u5f03\u5979\u5b64\u964b\u5be1\u95fb\u7684\u9762\u5b54\u3002<\/p>\n<p>\u201c\u6d77\u2026\u2026\u8bfa\u2026\u2026\u201d\u6735\u8389\u4e9a\u5ff5\u51fa\u8fd9\u4e2a\u540d\u5b57\uff0c\u603b\u89c9\u5f97\u4f3c\u4e4e\u5728\u54ea\u91cc\u542c\u8fc7\u3002\u201c\u547d\u8fd0\u4e4b\u5b50\u662f\u4ec0\u4e48\uff1f\u201d\u6735\u8389\u4e9a\u597d\u5947\u95ee\u5230\u3002<\/p>\n<p>\u201c\u547d\u8fd0\u4e4b\u5b50\uff0c\u90a3\u53ef\u5c31\u5389\u5bb3\u4e86\uff0c\u636e\u8bf4\u4ed6\u4eec\u4ee5\u524d\u88ab\u79f0\u4e3a\u6d77\u90fd\u524d\u8def\u7684\u9886\u822a\u8005\uff0c\u62e5\u6709\u7740\u80fd\u7aa5\u63a2\u547d\u8fd0\u548c\u672a\u6765\u7684\u80fd\u529b\uff0c\u7136\u800c\u2026\u2026\u201d<\/p>\n<p>\u201c\u4ec0\u4e48\uff1f\u4f60\u8bf4\u4ed6\u80fd\u9884\u6d4b\u547d\u8fd0\u548c\u672a\u6765\uff1f\u54c7\uff01\uff01\uff01\u60f3\u4e0d\u5230\u90a3\u4e2a\u5bb6\u4f19\u8fd9\u4e48\u5389\u5bb3\uff1f\u5feb\u5feb\u5feb\uff0c\u8bf7\u544a\u8bc9\u6211\u4ed6\u5bb6\u4f4f\u5728\u54ea\u91cc\uff1f\u201d\u6735\u8389\u4e9a\u5174\u594b\u7684\u8a00\u8bed\u6253\u65ad\u4e86\u6b63\u51c6\u5907\u6ed4\u6ed4\u4e0d\u7edd\u7684\u95e8\u7ae5\u3002<\/p>\n<p>\u5728\u5979\u7684\u201c\u6301\u4e4b\u4ee5\u6052\u201d\u4e0b\uff0c\u95e8\u7ae5\u7ec8\u4e8e\u8fd8\u662f\u653e\u5f03\u4e86\u8eab\u4e3a\u8ff7\u5f1f\u7684\u201c\u8bb2\u89e3\u201d\uff0c\u544a\u8bc9\u4e86\u6735\u8389\u4e9a\u547d\u8fd0\u5bb6\u65cf\u7684\u6240\u5728\u5730\u3002<\/p>\n<p>\u5728\u95e8\u7ae5\u65e0\u8010\u5730\u91cd\u590d\u7b2c\u4e09\u904d\u8bf4\u660e\u540e\uff0c\u6735\u8389\u4e9a\u7ec8\u4e8e\u8bb0\u4f4f\u4e86\u6d77\u8bfa\u5e9c\u90b8\u7684\u4f4d\u7f6e\u3002\u53c8\u5728\u5979\u62ce\u7740\u96e8\u4f1e\u591a\u7ed5\u4e86\u516d\u4e2a\u8def\u53e3\uff0c\u8d70\u9519\u4e86\u4e5d\u6761\u5c0f\u5df7\u4e4b\u540e\uff0c\u7ec8\u4e8e\u5728\u5915\u9633\u7684\u4f59\u6656\u4e0b\u89c1\u5230\u8fd9\u4e86\u5ea7\u87ba\u65cb\u72b6\u7684\u5bab\u6bbf\u3002<\/p>\n<p>\u201c\u662f\u4f60\uff01\u771f\u7684\u662f\u4f60\uff01\u547d\u8fd0\u4e4b\u5b50\uff0c\u4f60\u597d\u5440\uff01\u201d\u770b\u5230\u6b63\u597d\u51fa\u73b0\u5728\u94f6\u8272\u5927\u95e8\u5916\u7684\u8d35\u65cf\u7537\u5b50\uff0c\u7ad9\u5728\u62d0\u89d2\u53e3\u7684\u6735\u8389\u4e9a\u5174\u9ad8\u91c7\u70c8\u5730\u6325\u821e\u8d77\u53cc\u624b\uff0c\u5b8c\u5168\u6ca1\u6709\u6ce8\u610f\u5230\u6d77\u8bfa\u6b63\u5728\u95e8\u53e3\u9001\u8d70\u7684\u5ba2\u4eba\u2014\u2014\u4e00\u4e2a\u5e26\u7740\u5e3d\u5b50\u770b\u4e0a\u53bb\u6709\u51e0\u5206\u6ed1\u5934\u7684\u5c0f\u5b50\u5634\u89d2\u516b\u5366\u7684\u7b11\u610f\u3002<\/p>\n<p>\u6d77\u8bfa\u7684\u76ee\u5149\u770b\u5411\u4e0d\u8fdc\u5904\u7684\u84dd\u53d1\u5c11\u5973\uff0c\u601d\u5fd6\u5979\u600e\u4e48\u4f1a\u51fa\u73b0\u5728\u8fd9\u91cc\uff1f<\/p>\n<p>\u201c\u8fd9\u662f\u4f60\u7684\u96e8\u4f1e\uff0c\u5927\u529f\u544a\u6210\uff01\u7ec8\u4e8e\u80fd\u7269\u5f52\u539f\u4e3b\u5566\uff0c\u8c22\u8c22\u4f60\uff0c\u547d\u8fd0\u4e4b\u5b50\uff01\u201d\u5c11\u5973\u98de\u5954\u5230\u6d77\u8bfa\u8eab\u8fb9\uff0c\u5c06\u624b\u91cc\u62ce\u7740\u7684\u96e8\u4f1e\u6643\u8361\u5728\u4ed6\u773c\u524d\u3002<\/p>\n<p>\u201c\u4e0d\u5fc5\u4e86\uff0c\u5c31\u9001\u4f60\u5427\u3002\u201d\u60f3\u8d77\u4e4c\u4e91\u4e0b\uff0c\u84dd\u53d1\u5c11\u5973\u53cc\u624b\u6342\u5934\u5728\u6d77\u90fd\u8857\u4e0a\u72fc\u72c8\u72c2\u5954\u7684\u753b\u9762\uff0c\u6d77\u8bfa\u51b7\u51b7\u8bf4\u5230\uff0c\u8f6c\u8eab\u5c31\u51c6\u5907\u5f80\u56de\u5934\u3002<\/p>\n<p>\u201c\u7b49\u7b49\uff0c\u201d\u6735\u8389\u4e9a\u8fc8\u4e86\u4e00\u5927\u6b65\u6321\u5728\u6d77\u8bfa\u9762\u524d\uff0c\u5fd9\u4e0d\u8fed\u8bf4\u5230\u201c\u542c\u8bf4\u4f60\u662f\u6d77\u90fd\u7684\u547d\u8fd0\u4e4b\u5b50\uff0c\u80fd\u9884\u6d4b\u547d\u8fd0\u548c\u672a\u6765\uff0c\u773c\u4e0b\uff0c\u6211\u6709\u4e00\u4ef6\u5bf9\u6211\u6765\u8bf4\u5f88\u91cd\u8981\u5f88\u91cd\u8981\u2026\u2026\u201d<\/p>\n<p>\u201c\u8fd9\u8ddf\u6211\u6709\u4ec0\u4e48\u5173\u7cfb\u3002\u201d\u6d77\u8bfa\u9762\u65e0\u8868\u60c5\u5730\u6253\u65ad\u4e86\u84dd\u53d1\u5c11\u5973\u7684\u8bdd\u3002<\/p>\n<p>\u201c\u4f60\u77e5\u9053\u5417\uff1f\u7279\u522b\u795e\u5947\uff0c\u6211\u597d\u50cf\u4e0d\u5c0f\u5fc3\u5931\u53bb\u4e86\u4e00\u6bb5\u4f3c\u4e4e\u5f88\u91cd\u8981\u7684\u8bb0\u5fc6\uff0c\u60f3\u8ba9\u4f60\u2014\u2014\u4f20\u8bf4\u4e2d\u5927\u540d\u9f0e\u9f0e\u7684\u547d\u8fd0\u4e4b\u5b50\u5e2e\u6211\u9884\u6d4b\u4e00\u4e0b\uff0c\u5230\u5e95\u5728\u54ea\u513f\u53ef\u4ee5\u627e\u56de\u5b83\uff1f\u5982\u679c\u2026\u2026\u201d\u6735\u8389\u4e9a\u624d\u4e0d\u7406\u4f1a\u6d77\u8bfa\u7684\u6253\u65ad\uff0c\u81ea\u987e\u81ea\u5730\u8bf4\u5230\u3002<\/p>\n<p>\u201c\u5c0f\u59d0\uff0c\u5bf9\u547d\u8fd0\u5bb6\u65cf\u6765\u8bf4\uff0c\u9884\u6d4b\u672a\u6765\u662f\u4e00\u4ef6\u5f88\u4e25\u8083\u7684\u4e8b\u60c5\uff0c\u53ef\u4e0d\u662f\u7528\u6765\u968f\u968f\u4fbf\u4fbf\u5e2e\u4eba\u5360\u535c\u7684\u3002\u201d\u5728\u65c1\u4e00\u5411\u53e4\u677f\u7684\u5362\u6069\u7ba1\u5bb6\u7ec8\u4e8e\u5fcd\u4e0d\u4f4f\u53d1\u8bdd\u3002<\/p>\n<p>\u770b\u5c11\u4e3b\u4e00\u4ed8\u65e0\u5948\u7684\u6a21\u6837\uff0c\u5362\u6069\u62e6\u4f4f\u4f3c\u4e4e\u8fd8\u60f3\u201c\u575a\u6301\u4e0d\u61c8\u201d\u7684\u84dd\u53d1\u5c11\u5973\uff0c\u8ba9\u6d77\u8bfa\u5f84\u76f4\u8d70\u8fdb\u4e86\u5e9c\u90b8\u4e4b\u4e2d\u3002\u6025\u5f97\u6735\u8389\u4e9a\u5728\u5927\u95e8\u5916\u76f4\u8df3\u811a\uff0c\u201c\u5c0f\u6c14\u9b3c\u201d\u3001\u201c\u51b0\u5757\u8138\u201d\u3001\u201c\u51b7\u6f20\u602a\u201d\u2026\u2026\u6240\u6709\u5979\u773c\u4e0b\u80fd\u60f3\u5230\u5f62\u5bb9\u8fd9\u4e2a\u547d\u8fd0\u4e4b\u5b50\u7684\u8bf4\u6cd5\uff0c\u4e00\u80a1\u8111\u513f\u4ece\u5634\u91cc\u561f\u56d4\u4e86\u51fa\u6765\u3002<\/p>\n<p>\u201c\u8fd9\u4e2a\u5bb6\u4f19\uff0c\u8fd8\u771f\u662f\u4e2a\u9ebb\u70e6\u9b3c\uff0c\u4f46\u4e3a\u4ec0\u4e48\u6bcf\u6b21\u89c1\u5230\uff0c\u90fd\u89c9\u5f97\u6709\u4e9b\u719f\u6089\u3002\u201d\u6d77\u8bfa\u4e00\u8fb9\u7591\u60d1\u7740\uff0c\u4e00\u8fb9\u7a7f\u8fc7\u5bab\u6bbf\u7684\u5ead\u9662\u3002<\/p>\n<p>\u591c\u98ce\u63a0\u8d77