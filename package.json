{
  "name": "kaiju-player-companion",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --test server/player/*.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/player/**/*.{ts,tsx,css}\" \"server/{player,pro}/**/*.ts\" \"tests/player/**/*.ts\" \"scripts/player/*.mjs\" \"*.{ts,json}\"",
    "data:refresh": "node scripts/player/refresh-data.mjs",
    "ocr:setup": "node scripts/player/setup-ocr.mjs",
    "resources:refresh": "node scripts/player/refresh-resources.mjs",
    "bp:evaluate": "node scripts/player/benchmark-coach.mjs",
    "ranks:refresh": "node scripts/player/refresh-ranks.mjs",
    "tiers:evaluate": "node scripts/player/evaluate-environment.mjs",
    "tianyuan:collect": "node scripts/player/collect-tianyuan.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
