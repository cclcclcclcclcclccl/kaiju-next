# Optional model service. Hero atlas, drafting and journals work without a key.
# Copy this file to .env and configure a chat/completions-compatible provider.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=
# The model is called only when you click AI interpretation or replay analysis.
# Replay analysis requires an image-capable model; up to 6 selected frames and notes are sent.
# Original video files stay in your browser. No automatic background model calls.
PORT=4318
# PLAYER_DATA_DIR=data
