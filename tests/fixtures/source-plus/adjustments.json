skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/9d2624b33afcae1b251921aff560d143/178","skillId":"19020","skillName":"时空穿梭","skillType":"主动","skillPosition":"二技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"冷却时间：固定1.5 → 1.5(-0.1/Lv)\n蓝耗：50(+5/Lv) → 40(+5/Lv)"}]}]},{"id":868,"sourceId":975,"heroId":190,"type":2,"version":"V52","content":"增加技能命中机会","think":"我们一直希望诸葛亮能够在战场上发挥他最大的优势和特色，但是在相当长的一段时间里，峡谷发生了许多变化，为了应对这些变化，我们也对诸葛亮的机动性做了调整，但是这依然不能解决他在实战中跟不上节奏的问题，所以我们将适度对其1技能子弹的飞行速度做一些调整。","modifyLabel":"","modifyTime":"2020-03-17T02:35:27.000Z","other":[],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/661ccb5b3110c01ed1de5f233bbe0d2f/178","skillId":"19010","skillName":"东风破袭","skillType":"主动","skillPosition":"一技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"飞行速度:1200→1500"}]}]},{"id":869,"sourceId":874,"heroId":190,"type":2,"version":"V52","content":"加强灵活性","think":"诸葛亮的机动性在目前这个快节奏的对战中略微有些欠缺，因此我们略微缩短了2技能的冷却时间，让诸葛亮在对局中有更多的手段去调整位置。","modifyLabel":"","modifyTime":"2020-01-09T02:02:17.000Z","other":[{"title":"其他调整","descType":"1","oldContent":"","newContent":"基础生命值：3135(+180*英雄等级)→3229(+185.4*英雄等级)"}],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/9d2624b33afcae1b251921aff560d143/178","skillId":"19020","skillName":"时空穿梭","skillType":"主动","skillPosition":"二技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"冷却时间:2→1.5"}]}]},{"id":870,"sourceId":110,"heroId":190,"type":2,"version":"V45","content":"降低近身释放收益","think":"诸葛亮贴身爆发的能力在一定程度上已经越界，所以我们将下调1技能的累加伤害。另外我们还注意到诸葛亮在顺风局下表现会非常亮眼，而一旦逆风就变得十分乏力，对此我们调整了其伤害构成，使之更加平滑。","modifyLabel":"","modifyTime":"2019-07-30T06:00:46.000Z","other":[],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/661ccb5b3110c01ed1de5f233bbe0d2f/178","skillId":"19010","skillName":"东风破袭","skillType":"主动","skillPosition":"一技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"技能伤害：500(+80/Lv)(+0.8Ap)→500(+100/lv)(+0.7Ap)\n效果调整：命中同一目标从第二颗法球开始只造成30%伤害→命中同一目标从第二颗法球开始只造成20%伤害"}]}]},{"id":1001687,"sourceId":null,"heroId":190,"type":2,"version":null,"content":"普攻命中无视野修复","think":null,"modifyLabel":"修复","modifyTime":"2019-06-26T04:00:00.000Z","other":[{"title":"调整内容","descType":"1","oldContent":"","newContent":"修复了诸葛亮的普攻可以命中无视野英雄的BUG。"}],"skillList":[]},{"id":871,"sourceId":177,"heroId":190,"type":2,"version":"V44","content":"13技能伤害提高","think":"我们一直都在关注诸葛亮在战场上的表现，他在中前期的作战能力是非常抢眼的，但是一旦进入中后期，整体输出就会变得疲软，在团战中很难进行收割，因此我们将对这部分技能伤害做一定的上调。","modifyLabel":"","modifyTime":"2019-04-16T02:07:45.000Z","other":[],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/661ccb5b3110c01ed1de5f233bbe0d2f/178","skillId":"19010","skillName":"东风破袭","skillType":"主动","skillPosition":"一技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"伤害：500(+60/Lv)(+0.75Ap) → 500(+80/Lv)(+0.8Ap)            "}]},{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/542aecaea314d59634abb65f2a5775fd/178","skillId":"19030","skillName":"元气弹","skillType":"主动","skillPosition":"三技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"伤害：450(+150/Lv)(+0.5Ap) → 450(+180/Lv)(+0.55Ap)"}]}]},{"id":872,"sourceId":178,"heroId":190,"type":2,"version":"V42","content":"队友击败元气弹目标也会返还CD","think":"诸葛亮的元气弹的确是一个比较难以释放的技能，不仅需要考虑释放时机和敌方英雄的走位，还需要与自己队友良好地配合。此次调整我们将通过一些机制的改动适度降低队友之间的配合要求，一旦元气弹锁定的敌方英雄死亡，且没有触碰到其他英雄就会返回CD。我们希望调整以后，诸葛亮能够在战场上减少一些顾虑，可以更加大胆地去进行尝试。","modifyLabel":"","modifyTime":"2018-11-22T02:09:08.000Z","other":[{"title":"其他调整","descType":"1","oldContent":"","newContent":"修复了部分情况下诸葛亮动画播放异常的BUG"}],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/542aecaea314d59634abb65f2a5775fd/178","skillId":"19030","skillName":"元气弹","skillType":"主动","skillPosition":"三技能","describe":"修复了诸葛亮大招元气弹击败英雄时若飞行距离过长，将无法发动策谋之刻并减少冷却时间的BUG","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"增加效果：若元气弹的释放目标为敌方英雄，但在碰撞到该敌方英雄时目标已被击败，减少80%元气弹冷却时间。"}]}]},{"id":1001686,"sourceId":null,"heroId":190,"type":2,"version":null,"content":"三技能冷却刷新修复","think":null,"modifyLabel":"修复","modifyTime":"2018-07-04T04:00:00.000Z","other":[{"title":"调整内容","descType":"1","oldContent":"","newContent":"修复诸葛亮三技能有极小几率出现CD刷新异常的BUG"}],"skillList":[]},{"id":1001685,"sourceId":null,"heroId":190,"type":2,"version":null,"content":"庇护触发被动可成长","think":null,"modifyLabel":"增强","modifyTime":"2018-04-20T04:00:00.000Z","other":[{"title":"调整内容","descType":"1","oldContent":"","newContent":"优化了装备贤者的庇护相关机制，现在触发了装备的被动效果，被动也会获得成长"}],"skillList":[]},{"id":873,"sourceId":814,"heroId":190,"type":2,"version":"V20","content":"调整大招伤害构成","think":"一直以来大家都非常喜欢诸葛亮的玩法机制，尤其是在利用大招元气弹穿过人群直接击败敌方英雄刷新被动效果的时候。但是有趣的玩法是建立在互动上的，我们注意到许多时候，队友不愿意去帮助队友抵挡，原因是没有任何人可以承受如此剧痛的伤害，即使你是一位血量超厚的坦克也无法在血量较低的时候去抵挡这个伤害。这是因为大招伤害是按照目标已损失的血量来计算的，这就意味着血量越多反而会承受更多的伤害，这是不太合理的，所以我们专门为大招伤害做了单独的处理，让大招伤害对等百分比血量敌人造成的额外伤害是一致的，使这个技能有更多应对的可能。","modifyLabel":"","modifyTime":"2017-08-08T11:22:55.000Z","other":[],"skillList":[{"icon":"https://img.pvp.mcxssg.net/avatar?url=https://shp.qpic.cn/tgos/201701m2/542aecaea314d59634abb65f2a5775fd/178","skillId":"19030","skillName":"元气弹","skillType":"主动","skillPosition":"三技能","describe":"","modifyList":[{"title":"调整变动","descType":"1","oldContent":"","newContent":"伤害：360(+90/Lv)(+0.54Ap)(+30%目标已损生命)→450(+150/Lv)(+0.5Ap）[目标每损失1%生命提升该技能2%伤害]"}]}]},{"id":1001684,"sourceId":null,"heroId":190,"type":2,"version":null,"content":"被动基础下调成长提升","think":null,"modifyLabel":"平衡","modifyTime":"2017-04-18T04:00:00.000Z","other":[{"title":"调整内容","descType":"1","oldContent":"","newContent":"被动：\n伤害：350(+42*英雄等级)(+0.525Ap) → 270(+45*英雄等级)(+0.525Ap)"}],"skillList":[]},{"id":1001683,"sourceId":null,"heroId":190,"type":2,"version":null,"content":"移速被动与大招调整","think":null,"modifyLabel":"平衡","modifyTime":"2017-02-21T04:00:00.000Z","other":[{"title":"调整内容","descType":"1","oldContent":"","newContent":"移速： 360→350\n\n被动：\n移除对小兵野怪的额外伤害\n\n三技能：\n元气弹宽度：200→300"}],"skillList":[]}],"serverCached":"引用麻烦注明出处233"}